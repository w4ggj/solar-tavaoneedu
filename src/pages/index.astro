  async function loadWwv(): Promise<void> {
    try {
      const res = await fetch('/api/wwv');
      if (!res.ok) return;
      const d = await res.json() as Record<string, unknown>;
      const r = Number(d['R'] ?? d['r'] ?? 0);
      const s = Number(d['S'] ?? d['s'] ?? 0);
      const g = Number(d['G'] ?? d['g'] ?? 0);
      const row = document.getElementById('wwv-row');
      if (!row) return;
      function applyBadge(id: string, letter: string, val: number) {
        const el = document.getElementById(id);
        if (!el) return;
        const valEl = el.querySelector<HTMLElement>('.wb-val');
        if (valEl) valEl.textContent = letter + val;
        el.classList.remove('scale-active', 'scale-severe');
        if (val >= 3) el.classList.add('scale-severe');
        else if (val >= 1) el.classList.add('scale-active');
      }
      applyBadge('wb-r', 'R', r);
      applyBadge('wb-s', 'S', s);
      applyBadge('wb-g', 'G', g);
      row.hidden = false;
    } catch { /* non-fatal */ }
  }

  /* ── X-ray → R-scale ── */
  function xrayToR(xclass: string | null): { scale: number; label: string; freqs: string | null } {
    if (!xclass) return { scale: 0, label: 'No blackout', freqs: null };
    const l = xclass[0].toUpperCase();
    const v = parseFloat(xclass.slice(1));
    if (l === 'X' && v >= 20) return { scale: 5, label: 'Extreme blackout (R5)', freqs: '3–30 MHz completely blacked out' };
    if (l === 'X' && v >= 10) return { scale: 4, label: 'Severe blackout (R4)',  freqs: '3–30 MHz major HF degradation' };
    if (l === 'X')            return { scale: 3, label: 'Strong blackout (R3)',   freqs: '10–30 MHz wide-area HF blackout' };
    if (l === 'M' && v >= 5)  return { scale: 2, label: 'Moderate blackout (R2)', freqs: '10–20 MHz degraded on sunlit side' };
    if (l === 'M')            return { scale: 1, label: 'Minor blackout (R1)',    freqs: '15–20 MHz minor degradation' };
    return { scale: 0, label: 'No blackout', freqs: null };
  }

  function updateRadioBlackout(xclass: string | null): void {
    const badge  = document.getElementById('rb-badge');
    const scaleEl = document.getElementById('rb-scale');
    const descEl  = document.getElementById('rb-desc');
    const freqsEl = document.getElementById('rb-freqs');
    if (!badge || !scaleEl || !descEl || !freqsEl) return;
    const rb = xrayToR(xclass);
    scaleEl.textContent = 'R' + rb.scale;
    descEl.textContent  = rb.label;
    freqsEl.textContent = rb.freqs ?? '';
    badge.classList.remove('rb-none', 'rb-minor', 'rb-moderate', 'rb-strong');
    badge.classList.add(rb.scale === 0 ? 'rb-none' : rb.scale <= 2 ? 'rb-minor' : rb.scale <= 3 ? 'rb-moderate' : 'rb-strong');
  }

  /* ── Solar wind ── */
  function drawBzMiniChart(canvas: HTMLCanvasElement, bz: (number | null)[]): void {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const W = canvas.width, H = canvas.height;
    ctx.clearRect(0, 0, W, H);
    const vals = bz.filter((v): v is number => v !== null);
    if (!vals.length) return;
    const minV = Math.min(...vals, -10);
    const maxV = Math.max(...vals, 10);
    const range = maxV - minV || 1;
    const toX = (i: number) => (i / Math.max(bz.length - 1, 1)) * W;
    const toY = (v: number) => H - ((v - minV) / range) * H;
    const zeroY = toY(0);
    ctx.strokeStyle = '#334155'; ctx.lineWidth = 0.5;
    ctx.setLineDash([2, 2]);
    ctx.beginPath(); ctx.moveTo(0, zeroY); ctx.lineTo(W, zeroY); ctx.stroke();
    ctx.setLineDash([]);
    ctx.beginPath();
    let started = false;
    for (let i = 0; i < bz.length; i++) {
      if (bz[i] === null) { started = false; continue; }
      const x = toX(i), y = toY(bz[i]!);
      if (!started) { ctx.moveTo(x, y); started = true; } else ctx.lineTo(x, y);
    }
    ctx.strokeStyle = '#6ee7b7'; ctx.lineWidth = 1.5; ctx.stroke();
  }

  async function loadSolarWind(): Promise<void> {
    try {
      const res = await fetch('/api/solarwind');
      if (!res.ok) return;
      const d = await res.json() as {
        bz: number | null; bt: number | null; speed: number | null; density: number | null;
        updated: string;
        series?: { labels: string[]; bz: (number | null)[]; bt?: (number | null)[] };
      };
      const row = document.getElementById('sw-row');
      if (!row) return;
      const bzEl     = document.getElementById('sw-bz');
      const btEl     = document.getElementById('sw-bt');
      const speedEl  = document.getElementById('sw-speed');
      const densEl   = document.getElementById('sw-density');
      const bzBadge  = document.getElementById('sw-bz-badge');
      const updEl    = document.getElementById('sw-updated');
      if (bzEl && d.bz !== null) {
        bzEl.textContent = (d.bz > 0 ? '+' : '') + d.bz.toFixed(1);
        bzBadge?.classList.remove('sw-south', 'sw-north');
        if (d.bz < -5) bzBadge?.classList.add('sw-south');
        else if (d.bz > 5) bzBadge?.classList.add('sw-north');
      }
      if (btEl    && d.bt      !== null && d.bt      !== undefined) btEl.textContent    = d.bt.toFixed(1);
      if (speedEl && d.speed   !== null) speedEl.textContent  = Math.round(d.speed) + '';
      if (densEl  && d.density !== null) densEl.textContent   = d.density.toFixed(1);
      if (updEl   && d.updated)          updEl.textContent    = relTime(d.updated);
      row.hidden = false;
      if (d.series?.bz?.length) {
        const canvas = document.getElementById('sw-bz-chart') as HTMLCanvasElement | null;
        if (canvas) drawBzMiniChart(canvas, d.series.bz);
      }
      updateRadioBlackout(lastData?.xray_class ?? null);
    } catch { /* non-fatal */ }
  }

  /* ── Push notifications ── */
  function urlBase64ToUint8Array(b64: string): Uint8Array {
    const pad = b64.length % 4 === 0 ? '' : '='.repeat(4 - (b64.length % 4));
    const str = atob((b64 + pad).replace(/-/g, '+').replace(/_/g, '/'));
    return Uint8Array.from(str, c => c.charCodeAt(0));
  }

  function setPushUI(active: boolean): void {
    const btn   = document.getElementById('push-btn');
    const label = document.getElementById('push-label');
    const sub   = document.getElementById('push-subscribe');
    const unsub = document.getElementById('push-unsubscribe');
    if (!btn || !label || !sub || !unsub) return;
    btn.classList.toggle('push-active', active);
    label.textContent = active ? 'Alerts on' : 'Alerts';
    (sub   as HTMLButtonElement).hidden = active;
    (unsub as HTMLButtonElement).hidden = !active;
  }

  async function initPushUI(): Promise<void> {
    const btn    = document.getElementById('push-btn');
    const panel  = document.getElementById('push-panel') as HTMLElement | null;
    const subBtn = document.getElementById('push-subscribe');
    const unsubBtn = document.getElementById('push-unsubscribe');
    if (!btn || !panel || !subBtn || !unsubBtn) return;
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) return;
    let reg: ServiceWorkerRegistration;
    try { reg = await navigator.serviceWorker.register('/sw.js'); }
    catch { return; }
    const existing = await reg.pushManager.getSubscription();
    setPushUI(!!existing);
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      panel.hidden = !panel.hidden;
    });
    document.addEventListener('click', (e) => {
      if (!panel.hidden && !(e.target as Element)?.closest('#push-wrap')) panel.hidden = true;
    });
    subBtn.addEventListener('click', async () => {
      try {
        const res  = await fetch('/api/push-subscribe');
        const { publicKey } = await res.json() as { publicKey: string };
        if (!publicKey) throw new Error('no vapid key');
        const pushSub = await reg.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: urlBase64ToUint8Array(publicKey),
        });
        const kpVal   = Number((document.getElementById('push-kp') as HTMLSelectElement).value);
        const js: any = pushSub.toJSON();
        await fetch('/api/push-subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ endpoint: js.endpoint, p256dh: js.keys.p256dh, auth: js.keys.auth, kpThreshold: kpVal }),
        });
        setPushUI(true);
        panel.hidden = true;
      } catch (err) { console.warn('Push subscribe failed', err); }
    });
    unsubBtn.addEventListener('click', async () => {
      const cur = await reg.pushManager.getSubscription();
      if (cur) {
        await fetch('/api/push-subscribe', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ endpoint: cur.endpoint }),
        });
        await cur.unsubscribe();
      }
      setPushUI(false);
      panel.hidden = true;
    });
  }

  /* ── Aurora visibility forecast ── */
  function updateAurora(kp: number | null): void {
    const row    = document.getElementById('aurora-row') as HTMLElement | null;
    const badge  = document.getElementById('aurora-badge');
    const bound  = document.getElementById('aurora-bound');
    const region = document.getElementById('aurora-region');
    if (!row || !badge || !bound || !region) return;
    const kpVal = kp ?? 0;
    const lat   = Math.round(Math.max(49, Math.min(67, 67 - kpVal * 2)));
    bound.textContent = `≥${lat}°N`;
    let desc = '';
    if (kpVal >= 9) desc = 'France, Poland, northern US';
    else if (kpVal >= 8) desc = 'England, Germany, northern US';
    else if (kpVal >= 7) desc = 'UK, Amsterdam, upper Midwest US';
    else if (kpVal >= 6) desc = 'Scotland, southern Scandinavia, southern Canada';
    else if (kpVal >= 5) desc = 'Northern Scotland, Oslo, northern Canada';
    else if (kpVal >= 4) desc = 'Northern Norway, Iceland, Alaska';
    else if (kpVal >= 2) desc = 'Far northern Scandinavia, Alaska';
    else desc = 'High Arctic regions only';
    region.textContent = desc;
    badge.classList.toggle('aurora-active', kpVal >= 4);
    row.hidden = false;
  }

  /* ── 3-day space weather outlook ── */
  async function loadSpaceWx(): Promise<void> {
    try {
      const res = await fetch('/api/spacewx');
      if (!res.ok) return;
      const d = await res.json() as {
        days: Array<{
          label: string; date: string;
          rScale: number; rMinor: number; rMajor: number;
          sScale: number; sProb: number;
          gScale: number; gProb: number; kpMax: number;
        }>;
      };
      const row     = document.getElementById('swx-row') as HTMLElement | null;
      const daysEl  = document.getElementById('swx-days');
      const probsEl = document.getElementById('swx-probs');
      if (!row || !daysEl || !probsEl || !d.days?.length) return;

      daysEl.innerHTML = d.days.map(day => {
        const storm  = day.gScale >= 3 ? 'swx-severe' : day.gScale >= 1 ? 'swx-active' : '';
        const kpCol  = day.kpMax >= 5 ? '#f87171' : day.kpMax >= 3 ? '#fbbf24' : '#34d399';
        const kpTxt  = 'Kp' + (day.kpMax >= 5 ? '≥' : '≤') + day.kpMax;
        const probes = [
          day.rMinor > 0 ? `<span class="swx-pill swx-pill-r">R1+ <b>${day.rMinor}%</b></span>` : '',
          day.rMajor > 0 ? `<span class="swx-pill swx-pill-rx">R3+ <b>${day.rMajor}%</b></span>` : '',
          day.gProb  > 0 ? `<span class="swx-pill swx-pill-g">G <b>${day.gProb}%</b></span>`    : '',
        ].filter(Boolean).join('');
        return `<div class="swx-day ${storm}">
          <span class="swx-day-label">${day.label}</span>
          <span class="swx-kp" style="color:${kpCol}">${kpTxt}</span>
          ${probes ? `<div class="swx-pills">${probes}</div>` : '<span class="swx-quiet">Quiet</span>'}
        </div>`;
      }).join('');

      // 24h flare probabilities from today's period
      const today = d.days[0];
      if (today) {
        const probs = [
          { lbl: 'C-flare', val: today.rMinor, color: '#6ee7b7' },
          { lbl: 'M-flare', val: today.rMajor, color: '#fbbf24' },
          { lbl: 'G-storm', val: today.gProb,  color: '#a78bfa' },
        ];
        probsEl.innerHTML = `<span class="swx-probs-title">24h probabilities</span>` +
          probs.map(p => `
          <div class="swx-prob-row">
            <span class="swx-prob-lbl">${p.lbl}</span>
            <div class="swx-prob-bar"><div class="swx-prob-fill" style="width:${Math.max(3, Math.min(100,p.val))}%;background:${p.color}"></div></div>
            <span class="swx-prob-val" style="color:${p.color}">${p.val}%</span>
          </div>`).join('');
      }
      row.hidden = false;
    } catch { /* non-fatal */ }
  }

  /* ── Active solar regions ── */
  async function loadSolarRegions(): Promise<void> {
    try {
      const res = await fetch('/api/solarregions');
      if (!res.ok) return;
      const d = await res.json() as {
        regions: Array<{
          number: number; lat: string; lon: string;
          magClass: string; spots: number;
          probC: number; probM: number; probX: number;
        }>;
        updated: string;
      };
      const wrap = document.getElementById('ar-table-wrap');
      const stat = document.getElementById('ar-status');
      if (!wrap) return;
      if (!d.regions?.length) {
        if (stat) stat.textContent = 'No active numbered regions currently on the disk.';
        return;
      }
      if (stat) stat.remove();
      wrap.innerHTML = `<table class="ar-table">
        <thead><tr>
          <th>AR#</th><th>Lat/Lon</th><th>Mag</th><th>Spots</th>
          <th>C%</th><th>M%</th><th>X%</th>
        </tr></thead>
        <tbody>${d.regions.map(r => `<tr>
          <td class="ar-num">${r.number}</td>
          <td>${r.lat} ${r.lon}</td>
          <td class="ar-mag">${r.magClass}</td>
          <td>${r.spots}</td>
          <td class="ar-prob-c">${r.probC}</td>
          <td class="ar-prob-m">${r.probM}</td>
          <td class="ar-prob-x">${r.probX}</td>
        </tr>`).join('')}
        </tbody>
      </table>`;
    } catch { /* non-fatal */ }
  }

  /* ── Ham contest calendar ── */
  function renderContestCalendar(): void {
    const el = document.getElementById('contest-list');
    if (!el) return;
    const CONTESTS = [
      { name: 'CQ WW DX SSB',       start: '2026-10-24', end: '2026-10-25', mode: 'SSB',   bands: 'All HF' },
      { name: 'ARRL Sweepstakes CW', start: '2026-11-07', end: '2026-11-08', mode: 'CW',    bands: '160–10m' },
      { name: 'ARRL Sweepstakes SSB',start: '2026-11-21', end: '2026-11-22', mode: 'SSB',   bands: '160–10m' },
      { name: 'CQ WW DX CW',        start: '2026-11-28', end: '2026-11-29', mode: 'CW',     bands: 'All HF' },
      { name: 'ARRL 10m Contest',    start: '2026-12-12', end: '2026-12-13', mode: 'Mixed', bands: '10m only' },
      { name: 'ARRL DX CW',         start: '2027-02-20', end: '2027-02-21', mode: 'CW',    bands: '160–10m' },
      { name: 'ARRL DX SSB',        start: '2027-03-06', end: '2027-03-07', mode: 'SSB',   bands: '160–10m' },
      { name: 'CQ WPX SSB',         start: '2027-03-27', end: '2027-03-28', mode: 'SSB',   bands: 'All HF' },
      { name: 'CQ WPX CW',          start: '2027-05-29', end: '2027-05-30', mode: 'CW',    bands: 'All HF' },
      { name: 'ARRL Field Day',      start: '2027-06-26', end: '2027-06-27', mode: 'Mixed', bands: 'HF+VHF' },
      { name: 'IARU HF Championship',start: '2027-07-10', end: '2027-07-11', mode: 'Mixed', bands: 'All HF' },
    ];
    const now = Date.now();
    const upcoming = CONTESTS.filter(c => new Date(c.end + 'T23:59:00Z').getTime() > now).slice(0, 7);
    if (!upcoming.length) { el.innerHTML = '<p class="ar-empty">No upcoming contests in calendar.</p>'; return; }
    el.innerHTML = upcoming.map(c => {
      const startD = new Date(c.start + 'T00:00:00Z');
      const daysAway = Math.ceil((startD.getTime() - now) / 86400_000);
      const soon = daysAway <= 14;
      const modeCls = c.mode === 'CW' ? 'mode-cw' : c.mode === 'SSB' ? 'mode-ssb' : 'mode-mixed';
      const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      const dateStr = `${months[startD.getUTCMonth()]} ${startD.getUTCDate()}–${new Date(c.end+'T00:00:00Z').getUTCDate()}`;
      const countdown = daysAway <= 0 ? 'This weekend' : daysAway === 1 ? 'Tomorrow' : `${daysAway}d away`;
      return `<div class="contest-item${soon ? ' contest-soon' : ''}">
        <div class="contest-header">
          <span class="contest-date">${dateStr}, ${startD.getUTCFullYear()}</span>
          <span class="contest-countdown">${countdown}</span>
        </div>
        <span class="contest-name">${c.name}</span>
        <div class="contest-tags">
          <span class="contest-tag ${modeCls}">${c.mode}</span>
          <span class="contest-tag">${c.bands}</span>
        </div>
      </div>`;
    }).join('');
  }

  /* ── Proton flux ── */
  async function loadProtons(): Promise<void> {
    try {
      const res = await fetch('/api/protons');
      if (!res.ok) return;
      const d = await res.json() as { flux: number; scale: number; updated: string };
      const valEl   = document.getElementById('val-protons');
      const scaleEl = document.getElementById('val-protons-scale');
      const tile    = document.getElementById('tile-protons');
      if (valEl) valEl.textContent = d.flux < 10 ? d.flux.toFixed(2) : Math.round(d.flux) + '';
      if (scaleEl) {
        scaleEl.textContent = 'S' + d.scale;
        scaleEl.style.color = d.scale >= 3 ? '#f87171' : d.scale >= 1 ? '#fbbf24' : '';
      }
      if (tile) {
        tile.classList.remove('good', 'warn', 'bad');
        if (d.scale >= 2) tile.classList.add('bad');
        else if (d.scale >= 1) tile.classList.add('warn');
      }
    } catch { /* non-fatal */ }
  }

  /* ── Flare log ── */
  async function loadFlares(): Promise<void> {
    try {
      const res = await fetch('/api/flares');
      if (!res.ok) return;
      const d = await res.json() as { flares: Array<{ begin: string; peak: string | null; end: string | null; cls: string; region: string | null }> };
      const wrap   = document.getElementById('flare-table-wrap');
      const status = document.getElementById('flare-status');
      if (!wrap) return;
      if (!d.flares?.length) {
        if (status) status.textContent = 'No flares detected in the last 7 days.';
        return;
      }
      if (status) status.remove();
      function fmtUtc(iso: string): string {
        if (!iso) return '—';
        const dt = new Date(iso);
        const mm = String(dt.getUTCMonth() + 1).padStart(2, '0');
        const dd = String(dt.getUTCDate()).padStart(2, '0');
        const hh = String(dt.getUTCHours()).padStart(2, '0');
        const mn = String(dt.getUTCMinutes()).padStart(2, '0');
        return `${mm}/${dd} ${hh}:${mn}Z`;
      }
      function clsCss(cls: string): string {
        const l = (cls[0] ?? '').toUpperCase();
        return l === 'X' ? 'flare-cls-x' : l === 'M' ? 'flare-cls-m' : l === 'C' ? 'flare-cls-c' : 'flare-cls-b';
      }
      wrap.innerHTML = `<table class="flare-table">
        <thead><tr>
          <th>Begin (UTC)</th><th>Peak</th><th>End</th><th>Class</th><th>Region</th>
        </tr></thead>
        <tbody>${d.flares.map(f => `<tr>
          <td>${fmtUtc(f.begin)}</td>
          <td>${f.peak ? fmtUtc(f.peak) : '—'}</td>
          <td>${f.end  ? fmtUtc(f.end)  : 'ongoing'}</td>
          <td class="${clsCss(f.cls)}">${f.cls}</td>
          <td>${f.region ?? '—'}</td>
        </tr>`).join('')}
        </tbody>
      </table>`;
    } catch { /* non-fatal */ }
  }

  /* ── 3-day Kp bar chart ── */
  async function loadKp3day(): Promise<void> {
    try {
      const res = await fetch('https://services.swpc.noaa.gov/products/noaa-planetary-k-index.json');
      if (!res.ok) return;
      const raw = await res.json() as string[][];
      if (!Array.isArray(raw) || raw.length < 2) return;
      const [header, ...rows] = raw;
      const ti = header.indexOf('time_tag');
      const ki = header.findIndex((h: string) => /^kp/i.test(h));
      if (ti < 0 || ki < 0) return;
      const cutoff = Date.now() - 3 * 24 * 3600_000;
      const pts = rows
        .map(r => ({ t: r[ti], kp: parseFloat(r[ki]) }))
        .filter(r => r.t && !isNaN(r.kp) && new Date(r.t).getTime() >= cutoff);
      if (!pts.length) return;
      const chart = document.getElementById('kp3day-chart');
      if (!chart) return;
      function kpCol(kp: number): string {
        return kp >= 5 ? '#f87171' : kp >= 3 ? '#fbbf24' : '#10b981';
      }
      chart.innerHTML = pts.map(p => {
        const dt    = new Date(p.t);
        const h     = dt.getUTCHours().toString().padStart(2, '0');
        const col   = kpCol(p.kp);
        const barH  = Math.max(4, Math.round((p.kp / 9) * 72));
        const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        const dateStr = `${months[dt.getUTCMonth()]} ${dt.getUTCDate()}`;
        const label = h === '00' ? dateStr : h + 'Z';
        return `<div class="kp3day-bar-wrap" title="Kp ${p.kp} · ${dateStr} ${h}:00Z">
          <div class="kp3day-bar" style="height:${barH}px;background:${col}"></div>
          <span class="kp3day-label">${label}</span>
        </div>`;
      }).join('');
    } catch { /* non-fatal */ }
  }

  loadSolar();
  loadHistory(24);
  drawGreyline(0);
  refreshImages();
  loadWwv();
  loadSolarWind();
  updateRadioBlackout(null);
  updateAurora(null);
  loadSpaceWx();
  loadSolarRegions();
  loadProtons();
  loadFlares();
  loadKp3day();
  renderContestCalendar();
  initPushUI();
</script>

<script>
  import {
    Chart,
    LineController, BarController,
    CategoryScale, LinearScale, LogarithmicScale,
    PointElement, LineElement, BarElement,
    Tooltip, Filler,
  } from 'chart.js';

  Chart.register(
    LineController, BarController,
    CategoryScale, LinearScale, LogarithmicScale,
    PointElement, LineElement, BarElement,
    Tooltip, Filler,
  );

  // Dark-theme defaults
  Chart.defaults.color = '#94a3b8';
  Chart.defaults.borderColor = '#334155';
  Chart.defaults.font.family = "'JetBrains Mono', ui-monospace, monospace";
  Chart.defaults.font.size = 10;

  type ChartSeries = { labels: string[]; values: number[] };

  const charts: Record<string, Chart> = {};

  function shortLabel(bucket: string): string {
    if (bucket.includes('T')) {
      // 3-hour bucket: "2024-01-15T12:00:00Z" → "Jan 15 12:00"
      const d = new Date(bucket);
      return d.toLocaleDateString([], { month: 'short', day: 'numeric' }) + ' ' +
             d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }
    // Daily: "2024-01-15" → "Jan 15"
    const [, m, day] = bucket.split('-');
    const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    return `${months[parseInt(m) - 1]} ${parseInt(day)}`;
  }

  function makeLineChart(id: string, data: ChartSeries, color: string, refY?: number): Chart {
    const canvas = document.getElementById(id) as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const labels = data.labels.map(shortLabel);

    // Gradient fill
    const grad = ctx.createLinearGradient(0, 0, 0, 140);
    grad.addColorStop(0, color + '33');
    grad.addColorStop(1, color + '00');

    const datasets: any[] = [
      {
        data: data.values,
        borderColor: color,
        backgroundColor: grad,
        borderWidth: 2,
        pointRadius: data.labels.length < 20 ? 3 : 0,
        pointHoverRadius: 4,
        fill: true,
        tension: 0.3,
      },
    ];

    if (refY !== undefined) {
      datasets.push({
        data: Array(data.labels.length).fill(refY),
        borderColor: '#f8717155',
        borderWidth: 1,
        borderDash: [4, 3],
        pointRadius: 0,
        fill: false,
      });
    }

    return new Chart(ctx, {
      type: 'line',
      data: { labels, datasets },
      options: {
        responsive: false,
        animation: false,
        plugins: { tooltip: { mode: 'index', intersect: false }, legend: { display: false } },
        scales: {
          x: { grid: { color: '#1e293b' }, ticks: { maxTicksLimit: 8, maxRotation: 0 } },
          y: { grid: { color: '#1e293b' }, ticks: { maxTicksLimit: 5 } },
        },
      },
    });
  }

  function makeKpChart(id: string, obs: ChartSeries, fcst: Array<{ t: string; v: number }>): Chart {
    const canvas = document.getElementById(id) as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;

    const obsLabels = obs.labels.map(shortLabel);
    const obsNow = obs.labels.length > 0 ? obs.labels[obs.labels.length - 1] : '';
    const fcstFuture = fcst.filter(f => f.t > obsNow);
    const fcstLabels = fcstFuture.map(f => shortLabel(f.t));
    const fcstVals = fcstFuture.map(f => f.v);

    const allLabels = [...obsLabels, ...fcstLabels];
    const obsData = [...obs.values, ...Array(fcstLabels.length).fill(null)];
    const fcstData = [...Array(obsLabels.length).fill(null), ...fcstVals];

    function kpColor(v: number | null): string {
      if (v === null) return '#334155';
      if (v <= 2) return '#10b981';
      if (v <= 4) return '#fbbf24';
      return '#f87171';
    }

    return new Chart(ctx, {
      type: 'bar',
      data: {
        labels: allLabels,
        datasets: [
          {
            label: 'Kp observed',
            type: 'bar',
            data: obsData,
            backgroundColor: obs.values.map(kpColor),
            borderWidth: 0,
            barPercentage: 0.9,
          },
          {
            label: 'Kp forecast',
            type: 'line',
            data: fcstData,
            borderColor: '#6ee7b7',
            borderWidth: 2,
            borderDash: [5, 3],
            pointRadius: fcstLabels.length < 20 ? 3 : 0,
            pointBackgroundColor: '#6ee7b7',
            fill: false,
            tension: 0.3,
          },
          {
            label: 'Storm threshold',
            type: 'line',
            data: Array(allLabels.length).fill(5),
            borderColor: '#f8717155',
            borderWidth: 1,
            borderDash: [4, 3],
            pointRadius: 0,
            fill: false,
          },
        ] as any[],
      },
      options: {
        responsive: false,
        animation: false,
        plugins: { tooltip: { mode: 'index', intersect: false }, legend: { display: false } },
        scales: {
          x: { grid: { color: '#1e293b' }, ticks: { maxTicksLimit: 8, maxRotation: 0 } },
          y: { min: 0, max: 9, grid: { color: '#1e293b' }, ticks: { maxTicksLimit: 5 } },
        },
      },
    });
  }

  function parseForecast(raw: any): Array<{ t: string; v: number }> {
    if (!Array.isArray(raw) || !raw.length) return [];
    // New object format: [{time_tag, kp, ...}, ...]
    if (typeof raw[0] === 'object' && !Array.isArray(raw[0])) {
      return raw
        .map((r: any) => ({ t: r.time_tag ?? '', v: parseFloat(r.kp ?? r.kp_predicted ?? '0') }))
        .filter((r: any) => r.t && !isNaN(r.v));
    }
    // Legacy 2D format: [["time_tag","kp",...], ["2024-...", "3.00", ...], ...]
    const [header, ...rows] = raw as string[][];
    const ti = header.indexOf('time_tag');
    const ki = header.findIndex((h: string) => /kp/i.test(h));
    if (ti < 0 || ki < 0) return [];
    return rows
      .map(r => ({ t: r[ti] ?? '', v: parseFloat(r[ki] ?? '0') }))
      .filter(r => r.t && !isNaN(r.v));
  }

  function renderForecastStrip(fcst: Array<{ t: string; v: number }>): void {
    const row   = document.getElementById('fc-row') as HTMLElement | null;
    const strip = document.getElementById('fc-strip');
    if (!row || !strip) return;

    const now = Date.now();
    const future = fcst.filter(f => new Date(f.t).getTime() > now).slice(0, 8);
    if (!future.length) return;

    row.hidden = false;
    strip.innerHTML = future.map(f => {
      const h      = new Date(f.t).getUTCHours().toString().padStart(2, '0') + ':00Z';
      const kp     = f.v;
      const col    = kp >= 5 ? '#f87171' : kp >= 3 ? '#fbbf24' : '#10b981';
      const barH   = Math.max(3, Math.round((kp / 9) * 44));
      return `<div class="fc-slot" role="listitem" aria-label="Kp ${kp.toFixed(1)} at ${h}">
        <div class="fc-bars-area">
          <div class="fc-bar" style="height:${barH}px;background:${col};opacity:0.82"></div>
        </div>
        <span class="fc-kp" style="color:${col}">${kp.toFixed(1)}</span>
        <span class="fc-time">${h}</span>
      </div>`;
    }).join('');
  }

  function makeKp24Chart(id: string, data: ChartSeries): Chart {
    const canvas = document.getElementById(id) as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    function kpColor(v: number): string {
      return v <= 2 ? '#10b981' : v <= 4 ? '#fbbf24' : '#f87171';
    }
    return new Chart(ctx, {
      type: 'bar',
      data: {
        labels: data.labels.map(b => {
          const d = new Date(b);
          return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + 'Z';
        }),
        datasets: [{
          data: data.values,
          backgroundColor: data.values.map(kpColor),
          borderWidth: 0,
          barPercentage: 0.85,
        }] as any[],
      },
      options: {
        responsive: false,
        animation: false,
        plugins: { tooltip: { mode: 'index', intersect: false }, legend: { display: false } },
        scales: {
          x: { grid: { color: '#1e293b' }, ticks: { maxTicksLimit: 8, maxRotation: 0 } },
          y: { min: 0, max: 9, grid: { color: '#1e293b' }, ticks: { stepSize: 3 } },
        },
      },
    });
  }

  function makeXrayChart(id: string, data: ChartSeries): Chart {
    const canvas = document.getElementById(id) as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const grad = ctx.createLinearGradient(0, 0, 0, 140);
    grad.addColorStop(0, '#f8717133');
    grad.addColorStop(1, '#f8717100');
    const safeValues = data.values.map(v => Math.max(0.001, v));
    return new Chart(ctx, {
      type: 'line',
      data: {
        labels: data.labels.map(l => {
          const d = new Date(l);
          return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + 'Z';
        }),
        datasets: [{
          data: safeValues,
          borderColor: '#f87171',
          backgroundColor: grad,
          borderWidth: 1.5,
          pointRadius: 0,
          fill: true,
          tension: 0.2,
        }] as any[],
      },
      options: {
        responsive: false,
        animation: false,
        plugins: { tooltip: { mode: 'index', intersect: false }, legend: { display: false } },
        scales: {
          x: { grid: { color: '#1e293b' }, ticks: { maxTicksLimit: 8, maxRotation: 0 } },
          y: {
            type: 'logarithmic',
            min: 0.001,
            grid: { color: '#1e293b' },
            ticks: {
              callback: (v: any) => {
                if (v === 0.1) return 'A';
                if (v === 1) return 'B';
                if (v === 10) return 'C';
                if (v === 100) return 'M';
                if (v === 1000) return 'X';
                return '';
              },
            },
          },
        },
      },
    });
  }

  async function loadTrends() {
    // SFI
    const sfiData = await fetchSeries('sfi', 30);
    if (sfiData) charts['sfi'] = makeLineChart('canvas-sfi', sfiData, '#10b981');

    // K-index + forecast
    const [kpData, fcstRaw] = await Promise.all([
      fetchSeries('kindex', 7),
      fetch('/api/history?metric=kforecast').then(r => r.ok ? r.json() : null).catch(() => null),
    ]);
    const fcst = parseForecast(fcstRaw ?? []);
    if (kpData) charts['kp'] = makeKpChart('canvas-kp', kpData, fcst);
    renderForecastStrip(fcst);

    // 24h Kp bar chart
    const kp24Data = await fetchSeries('kindex', 1);
    if (kp24Data) charts['kp24'] = makeKp24Chart('canvas-kp24', kp24Data);

    // X-ray flux 6-hour chart
    try {
      const xres = await fetch('/api/xray');
      if (xres.ok) {
        const xd: ChartSeries = await xres.json();
        if (xd.labels?.length) charts['xray'] = makeXrayChart('canvas-xray', xd);
      }
    } catch {}

    // A-index (daily geomagnetic activity) — try 7 d then 30 d; show placeholder if no data yet
    let aiData = await fetchSeries('aindex', 7);
    if (!aiData) aiData = await fetchSeries('aindex', 30);
    if (aiData && aiData.labels.length >= 2) {
      charts['aindex'] = makeLineChart('canvas-aindex', aiData, '#a78bfa', 50);
    } else {
      const aiBody = document.querySelector<HTMLElement>('#tc-aindex .tc-body');
      if (aiBody) aiBody.innerHTML = `<div class="tc-empty"><span>A-index history is building.</span><span>Check back in 24–48 h as readings accumulate.</span></div>`;
    }

    // Sunspots
    const ssnData = await fetchSeries('sunspots', 30);
    if (ssnData) charts['ssn'] = makeLineChart('canvas-ssn', ssnData, '#6ee7b7');

    // Solar Cycle 25 position
    try {
      const scRes = await fetch('/api/solarcycle');
      if (scRes.ok) {
        const sc = await scRes.json() as {
          data: Array<{ t: string; observed: number | null; predicted: number | null; high: number | null; low: number | null }>;
          currentSsn: number | null;
        };
        if (sc.data?.length) {
          const curEl = document.getElementById('sc-cur-ssn');
          if (curEl && sc.currentSsn !== null) curEl.textContent = 'SSN ' + sc.currentSsn;
          charts['solarcycle'] = makeSolarCycleChart('canvas-solarcycle', sc.data);
        }
      }
    } catch {}
  }

  function makeSolarCycleChart(
    id: string,
    data: Array<{ t: string; observed: number | null; predicted: number | null; high: number | null; low: number | null }>
  ): Chart {
    const canvas = document.getElementById(id) as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const labels = data.map((r, i) => i % 6 === 0 ? r.t : '');
    return new Chart(ctx, {
      type: 'line',
      data: {
        labels,
        datasets: [
          {
            label: 'Observed SSN',
            data: data.map(r => r.observed),
            borderColor: '#10b981',
            backgroundColor: '#10b98118',
            borderWidth: 2,
            pointRadius: 0,
            fill: true,
            tension: 0.35,
            spanGaps: false,
          },
          {
            label: 'NOAA Predicted',
            data: data.map(r => r.predicted),
            borderColor: '#6ee7b7',
            borderWidth: 1.5,
            borderDash: [5, 4],
            pointRadius: 0,
            fill: false,
            tension: 0.35,
            spanGaps: true,
          },
          {
            label: 'High',
            data: data.map(r => r.high),
            borderColor: '#6ee7b722',
            borderWidth: 0,
            pointRadius: 0,
            fill: '+1',
            tension: 0.35,
            spanGaps: true,
          },
          {
            label: 'Low',
            data: data.map(r => r.low),
            borderColor: '#6ee7b710',
            backgroundColor: '#6ee7b710',
            borderWidth: 0,
            pointRadius: 0,
            fill: false,
            tension: 0.35,
            spanGaps: true,
          },
        ] as any[],
      },
      options: {
        responsive: false,
        animation: false,
        plugins: { tooltip: { mode: 'index', intersect: false }, legend: { display: false } },
        scales: {
          x: { grid: { color: '#1e293b' }, ticks: { maxTicksLimit: 10, maxRotation: 0 } },
          y: { min: 0, grid: { color: '#1e293b' }, ticks: { maxTicksLimit: 5 } },
        },
      },
    });
  }

  async function fetchSeries(metric: string, days: number): Promise<ChartSeries | null> {
    try {
      const res = await fetch(`/api/history?metric=${metric}&days=${days}`);
      if (!res.ok) return null;
      const d: ChartSeries = await res.json();
      return d.labels?.length ? d : null;
    } catch {
      return null;
    }
  }

  const CHART_METRIC: Record<string, string> = {
    sfi: 'sfi', ssn: 'sunspots', aindex: 'aindex', kp: 'kindex',
  };
  const CHART_COLOR: Record<string, string> = {
    sfi: '#10b981', ssn: '#6ee7b7', aindex: '#a78bfa', kp: '#10b981',
  };
  const CHART_REF: Record<string, number | undefined> = {
    aindex: 50,
  };

  async function reloadChart(chartKey: string, days: number) {
    const metric = CHART_METRIC[chartKey] ?? chartKey;
    const data = await fetchSeries(metric, days);
    if (!data || (chartKey === 'aindex' && data.labels.length < 2)) {
      if (chartKey === 'aindex') {
        const aiBody = document.querySelector<HTMLElement>('#tc-aindex .tc-body');
        if (aiBody) aiBody.innerHTML = `<div class="tc-empty"><span>A-index history is building.</span><span>Check back in 24–48 h as readings accumulate.</span></div>`;
      }
      return;
    }
    const old = charts[chartKey];
    if (old) old.destroy();
    charts[chartKey] = makeLineChart(`canvas-${chartKey}`, data, CHART_COLOR[chartKey] ?? '#10b981', CHART_REF[chartKey]);
  }

  // Tab wiring
  document.querySelectorAll<HTMLButtonElement>('.tc-tab').forEach(btn => {
    btn.addEventListener('click', async () => {
      const chartKey = btn.dataset.chart!;
      const days = Number(btn.dataset.days);
      btn.closest('.tc-tabs')!.querySelectorAll('.tc-tab').forEach(t => t.classList.remove('active'));
      btn.classList.add('active');
      await reloadChart(chartKey, days);
    });
  });

  loadTrends();
</script>
