---
import Shell from '../layouts/Shell.astro';
---

<Shell
  title="Solar Dashboard — TavaOne Solar"
  description="Real-time solar flux, geomagnetic indices, and HF propagation data for amateur radio operators."
>
  <div id="storm-banner" class="storm-banner" hidden role="alert" aria-live="assertive">
    <div class="wrap sb-inner">
      <span class="sb-icon" aria-hidden="true">⚡</span>
      <span id="sb-text" class="sb-text"></span>
      <button id="sb-close" class="sb-close" type="button" aria-label="Dismiss alert">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <section class="page-hero" aria-label="Solar conditions">
    <div class="wrap">
      <p class="eyebrow">Live <span class="dim">· Updated every 15 min</span></p>
      <h1>Solar <span class="em">Conditions</span></h1>
      <p class="lede">Real-time solar flux, geomagnetic indices, and band propagation — built for amateur radio operators.</p>
    </div>
    <div class="signal" aria-hidden="true">
      <svg viewBox="0 0 1200 80" preserveAspectRatio="none">
        <g class="wave-grp" fill="none" stroke="#10b981" stroke-width="2" opacity="0.65">
          <path d="M -200,40 C -167,12 -133,12 -100,40 C -67,68 -33,68 0,40 C 33,12 67,12 100,40 C 133,68 167,68 200,40 C 233,12 267,12 300,40 C 333,68 367,68 400,40 C 433,12 467,12 500,40 C 533,68 567,68 600,40 C 633,12 667,12 700,40 C 733,68 767,68 800,40 C 833,12 867,12 900,40 C 933,68 967,68 1000,40 C 1033,12 1067,12 1100,40 C 1133,68 1167,68 1200,40 C 1233,12 1267,12 1300,40 C 1333,68 1367,68 1400,40 C 1433,12 1467,12 1500,40 C 1533,68 1567,68 1600,40 C 1633,12 1667,12 1700,40 C 1733,68 1767,68 1800,40 C 1833,12 1867,12 1900,40 C 1933,68 1967,68 2000,40 C 2033,12 2067,12 2100,40 C 2133,68 2167,68 2200,40"/>
        </g>
      </svg>
      <span class="tag">SOLAR</span>
    </div>
  </section>

  <section id="dashboard" aria-label="Live data">
    <div class="wrap">
      <p class="seclabel">Live Conditions</p>
      <h2>Current solar data</h2>
      <p class="sec-intro">Solar flux index, geomagnetic conditions, and X-ray flux — refreshed every 15 minutes from NOAA SWPC.</p>

      <div class="data-grid">
        <div class="data-tile" id="tile-sfi">
          <div class="dt-label">Solar Flux (SFI)</div>
          <div class="dt-value" id="val-sfi">—</div>
          <div class="dt-meta">10.7 cm radio flux</div>
        </div>
        <div class="data-tile" id="tile-aindex">
          <div class="dt-label">A-Index</div>
          <div class="dt-value" id="val-aindex">—</div>
          <div class="dt-meta">Geomagnetic Ap (3-hr)</div>
        </div>
        <div class="data-tile" id="tile-kindex">
          <div class="dt-label">K-Index</div>
          <div class="dt-value" id="val-kindex">—</div>
          <div class="dt-meta">Planetary Kp (real-time)</div>
        </div>
        <div class="data-tile" id="tile-xray">
          <div class="dt-label">X-Ray Class</div>
          <div class="dt-value" id="val-xray">—</div>
          <div class="dt-meta">GOES satellite</div>
        </div>
      </div>
      <p class="data-updated" id="data-updated"></p>
      <div class="share-row">
        <a href="/card/" class="share-link">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <circle cx="11" cy="2.5" r="1.5" stroke="currentColor" stroke-width="1.4"/>
            <circle cx="11" cy="11.5" r="1.5" stroke="currentColor" stroke-width="1.4"/>
            <circle cx="3"  cy="7"   r="1.5" stroke="currentColor" stroke-width="1.4"/>
            <path d="M4.5 6.2 9.5 3.3M4.5 7.8 9.5 10.7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
          Share conditions
        </a>
      </div>
    </div>
  </section>

  <section id="band-conditions" aria-label="HF band conditions">
    <div class="wrap">
      <p class="seclabel">Derived from Live Data</p>
      <h2>HF band conditions</h2>
      <p class="sec-intro" id="band-basis">Loading conditions…</p>

      <div class="bc-time-row">
        <div class="bc-time-head">
          <span class="bc-time-label">Simulated time:</span>
          <span id="bc-time-display" class="bc-time-val">Now</span>
          <button id="bc-reset" class="bc-reset-btn" type="button" hidden>Reset</button>
        </div>
        <input type="range" id="bc-offset" class="bc-slider" min="-12" max="12" step="0.5" value="0" aria-label="Time offset in hours from now">
        <div class="bc-slider-ticks"><span>−12 h</span><span>now</span><span>+12 h</span></div>
      </div>

      <div class="band-grid" id="band-grid"></div>
      <p class="data-updated" style="margin-top:14px">Estimated from SFI and Kp · real conditions vary by path, antenna, and solar terminator</p>
    </div>
  </section>

  <section id="greyline" aria-label="Solar terminator map">
    <div class="wrap">
      <p class="seclabel">Solar Terminator</p>
      <h2>Greyline map</h2>
      <p class="sec-intro">The greyline is the twilight boundary between day and night. The 30-minute window around it — when the ionosphere is in transition — often produces outstanding long-path propagation on 40 m and 80 m.</p>
      <div class="gl-outer">
        <canvas id="gl-canvas" class="gl-canvas" aria-label="Solar terminator world map"></canvas>
        <div class="gl-info">
          <span id="gl-utc" class="gl-stat"></span>
          <span class="gl-sep">·</span>
          <span id="gl-sun" class="gl-stat"></span>
        </div>
      </div>
      <p class="data-updated" style="margin-top:10px">Equirectangular projection · terminator updates every minute · yellow dot = subsolar point · dashed lines = tropics</p>
    </div>
  </section>

  <section id="solar-imagery" aria-label="Live solar images">
    <div class="wrap">
      <p class="seclabel">NASA / ESA Live Imagery</p>
      <h2>The sun right now</h2>
      <p class="sec-intro">Live solar imagery from NASA's Solar Dynamics Observatory and the ESA/NASA SOHO spacecraft — updated every few minutes.</p>
      <div class="imagery-grid">
        <figure class="img-card">
          <div class="img-wrap"><img id="img-aia193" src="" alt="SDO AIA 193 Å coronal plasma" class="solar-img" loading="lazy" /></div>
          <figcaption><strong>SDO AIA 193 Å</strong> · Hot coronal plasma at ~1.5 MK. Bright regions are active areas — flare-prone loops and spots that drive X-ray bursts.</figcaption>
        </figure>
        <figure class="img-card">
          <div class="img-wrap"><img id="img-hmi" src="" alt="SDO HMI white-light sunspot map" class="solar-img" loading="lazy" /></div>
          <figcaption><strong>SDO HMI Continuum</strong> · White-light sunspot map. Dark umbral regions indicate strong magnetic flux — more spots correlate directly with higher SFI.</figcaption>
        </figure>
        <figure class="img-card">
          <div class="img-wrap"><img id="img-lasco" src="" alt="SOHO LASCO C3 coronagraph" class="solar-img" loading="lazy" /></div>
          <figcaption><strong>SOHO LASCO C3</strong> · Coronagraph — white disk occludes the sun. Bright expanding halos are coronal mass ejections (CMEs) that may reach Earth in 1–3 days.</figcaption>
        </figure>
      </div>
      <p class="data-updated" style="margin-top:14px">NASA SDO (sdo.gsfc.nasa.gov) · ESA/NASA SOHO (soho.nascom.nasa.gov) · Images delayed ~15–60 min from real-time</p>
    </div>
  </section>

  <section id="history" aria-label="Solar history">
    <div class="wrap">
      <div class="history-top">
        <div>
          <p class="seclabel" id="history-label">24-Hour History</p>
          <h2>Solar trend</h2>
        </div>
        <div class="range-tabs" role="group" aria-label="Time range">
          <button class="range-tab" data-hours="6">6 h</button>
          <button class="range-tab active" data-hours="24">24 h</button>
          <button class="range-tab" data-hours="168">7 d</button>
        </div>
      </div>

      <div class="grid cols2" style="margin-top:24px">
        <div class="chart-card">
          <div class="chart-head">
            <span class="chart-lbl">Solar Flux Index (SFI)</span>
            <span class="chart-cur" id="chart-sfi-cur"></span>
          </div>
          <svg id="chart-sfi" class="chart-svg" viewBox="0 0 560 80" preserveAspectRatio="none">
            <text x="280" y="44" text-anchor="middle" fill="#475569" font-size="11" font-family="monospace">loading…</text>
          </svg>
          <div class="chart-foot">
            <span id="chart-sfi-start"></span>
            <span>now</span>
          </div>
        </div>

        <div class="chart-card">
          <div class="chart-head">
            <span class="chart-lbl">K-Index (Kp)</span>
            <span class="chart-cur" id="chart-kp-cur"></span>
          </div>
          <svg id="chart-kp" class="chart-svg" viewBox="0 0 560 80" preserveAspectRatio="none">
            <text x="280" y="44" text-anchor="middle" fill="#475569" font-size="11" font-family="monospace">loading…</text>
          </svg>
          <div class="chart-foot">
            <span id="chart-kp-start"></span>
            <span>now</span>
          </div>
        </div>
      </div>
      <p class="data-updated" id="history-updated"></p>
    </div>
  </section>

  <section id="trends" aria-label="Solar trend charts">
    <div class="wrap">
      <p class="seclabel">Trend Analysis</p>
      <h2>Historical solar data</h2>
      <p class="sec-intro">Long-term trends in solar flux, geomagnetic activity, and sunspot cycle — updated every 15 minutes from NOAA SWPC.</p>

      <div class="trends-grid">

        <!-- SFI trend -->
        <div class="trend-card" id="tc-sfi">
          <div class="tc-head">
            <span class="tc-lbl">Solar Flux Index (SFI)</span>
            <div class="tc-tabs" role="group" aria-label="SFI range">
              <button class="tc-tab active" data-chart="sfi" data-days="30">30 d</button>
              <button class="tc-tab" data-chart="sfi" data-days="60">60 d</button>
              <button class="tc-tab" data-chart="sfi" data-days="90">90 d</button>
            </div>
          </div>
          <div class="tc-body"><canvas id="canvas-sfi"></canvas></div>
        </div>

        <!-- K-index 7-day bars + forecast -->
        <div class="trend-card" id="tc-kp">
          <div class="tc-head">
            <span class="tc-lbl">Planetary K-Index — 7 days + forecast</span>
          </div>
          <div class="tc-body"><canvas id="canvas-kp"></canvas></div>
        </div>

        <!-- Sunspot trend -->
        <div class="trend-card trend-card--wide" id="tc-ssn">
          <div class="tc-head">
            <span class="tc-lbl">Sunspot Number (SSN)</span>
            <div class="tc-tabs" role="group" aria-label="SSN range">
              <button class="tc-tab active" data-chart="ssn" data-days="30">30 d</button>
              <button class="tc-tab" data-chart="ssn" data-days="60">60 d</button>
              <button class="tc-tab" data-chart="ssn" data-days="90">90 d</button>
            </div>
          </div>
          <div class="tc-body"><canvas id="canvas-ssn"></canvas></div>
        </div>

      </div>
    </div>
  </section>

  <section id="what-it-means" aria-label="Impact on radio">
    <div class="wrap">
      <p class="seclabel">Ham Radio Impact</p>
      <h2>What the numbers mean for your radio</h2>
      <p class="sec-intro" id="conditions-summary">Loading current conditions…</p>
      <div class="grid cols3" style="margin-top:32px">
        <div class="card">
          <div class="ico">📻</div>
          <h3>HF Propagation</h3>
          <p id="card-hf">Loading…</p>
        </div>
        <div class="card">
          <div class="ico">🌍</div>
          <h3>Geomagnetic Activity</h3>
          <p id="card-geo">Loading…</p>
        </div>
        <div class="card">
          <div class="ico">☀️</div>
          <h3>Solar Events</h3>
          <p id="card-solar">Loading…</p>
        </div>
      </div>
    </div>
  </section>

  <section id="learn-teaser" aria-label="Learn more">
    <div class="wrap">
      <p class="seclabel">Education</p>
      <h2>Why does any of this matter?</h2>
      <p class="sec-intro">Solar activity directly shapes the ionosphere — and the ionosphere controls which amateur radio bands are open and how far your contacts can reach. Once you understand the connection, you'll know exactly when to call CQ.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/learn/">Learn about propagation →</a>
        <a class="btn btn-ghost" href="https://tavaoneeducation.org/" target="_blank" rel="noopener">TavaOne Education ↗</a>
      </div>
    </div>
  </section>
</Shell>

<style>
  /* ── Storm alert banner ── */
  .storm-banner {
    background: rgba(245,158,11,.10);
    border-bottom: 1px solid rgba(245,158,11,.30);
    padding: 9px 0;
  }
  .storm-banner.sb-severe {
    background: rgba(239,68,68,.10);
    border-bottom-color: rgba(239,68,68,.30);
  }
  .sb-inner {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .sb-icon { font-size: .95rem; flex-shrink: 0; }
  .sb-text {
    flex: 1;
    font-size: .8rem;
    font-family: var(--mono);
    color: #fbbf24;
    letter-spacing: .04em;
    line-height: 1.45;
  }
  .storm-banner.sb-severe .sb-text { color: #f87171; }
  .sb-close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
    color: var(--muted);
    opacity: .65;
    flex-shrink: 0;
    line-height: 0;
    border-radius: 4px;
  }
  .sb-close:hover { opacity: 1; background: rgba(255,255,255,.05); }

  .data-updated {
    margin-top: 12px;
    font-family: var(--mono);
    font-size: .74rem;
    color: var(--muted);
    opacity: .6;
    letter-spacing: .06em;
  }

  .share-row {
    margin-top: 16px;
    display: flex;
  }
  .share-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--mono);
    font-size: .75rem;
    letter-spacing: .06em;
    color: var(--muted);
    text-decoration: none;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 7px;
    transition: color .18s, border-color .18s;
  }
  .share-link:hover {
    color: var(--green-lt);
    border-color: var(--green-dk);
  }

  /* History section */
  .history-top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }
  .range-tabs {
    display: flex;
    gap: 3px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 3px;
    flex-shrink: 0;
  }
  .range-tab {
    background: none;
    border: none;
    padding: 5px 13px;
    border-radius: 5px;
    font-family: var(--mono);
    font-size: .75rem;
    letter-spacing: .06em;
    color: var(--muted);
    cursor: pointer;
    transition: background .12s, color .12s;
  }
  .range-tab:hover { color: var(--text); }
  .range-tab.active { background: var(--green-dk); color: var(--green-lt); }

  /* Chart cards */
  .chart-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px 22px 14px;
    transition: border-color .18s;
  }
  .chart-card:hover { border-color: var(--green-dk); }
  .chart-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .chart-lbl {
    font-family: var(--mono);
    font-size: .72rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .chart-cur {
    font-family: var(--mono);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--green-lt);
  }
  .chart-svg {
    display: block;
    width: 100%;
    height: 88px;
  }
  .chart-foot {
    display: flex;
    justify-content: space-between;
    margin-top: 7px;
    font-family: var(--mono);
    font-size: .68rem;
    color: var(--muted);
    opacity: .5;
  }

  /* ── Trend charts section ── */
  #trends { padding-top: 0; }
  .trends-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: 32px;
  }
  .trend-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px 22px 16px;
    transition: border-color .18s;
    min-width: 0;
  }
  .trend-card:hover { border-color: var(--green-dk); }
  .trend-card--wide { grid-column: 1 / -1; }
  .tc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 14px;
  }
  .tc-lbl {
    font-family: var(--mono);
    font-size: .72rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tc-tabs {
    display: flex;
    gap: 2px;
    background: rgba(255,255,255,.04);
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 2px;
  }
  .tc-tab {
    background: none;
    border: none;
    padding: 4px 11px;
    border-radius: 5px;
    font-family: var(--mono);
    font-size: .7rem;
    letter-spacing: .06em;
    color: var(--muted);
    cursor: pointer;
    transition: background .12s, color .12s;
  }
  .tc-tab:hover { color: var(--text); }
  .tc-tab.active { background: var(--green-dk); color: var(--green-lt); }
  .tc-body { position: relative; }
  .tc-body canvas { display: block; width: 100% !important; height: 140px !important; }

  @media (max-width: 820px) {
    .trends-grid { grid-template-columns: 1fr; }
    .trend-card--wide { grid-column: auto; }
  }

  /* ── Band conditions time slider ── */
  .bc-time-row {
    margin: 16px 0 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .bc-time-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: .75rem;
  }
  .bc-time-label { color: var(--muted); }
  .bc-time-val   { color: var(--green-lt); font-weight: 600; }
  .bc-reset-btn {
    margin-left: auto;
    background: none;
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 2px 8px;
    font-family: var(--mono);
    font-size: .68rem;
    color: var(--muted);
    cursor: pointer;
  }
  .bc-reset-btn:hover { border-color: var(--green-dk); color: var(--green-lt); }
  .bc-slider { width: 100%; accent-color: #10b981; cursor: pointer; }
  .bc-slider-ticks {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: .65rem;
    color: var(--muted);
    opacity: .55;
  }

  /* ── Greyline map ── */
  #greyline { padding-top: 0; }
  .gl-outer {
    margin-top: 24px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .gl-canvas { display: block; width: 100%; height: auto; image-rendering: pixelated; }
  .gl-info {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: rgba(0,0,0,.4);
    font-family: var(--mono);
    font-size: .72rem;
  }
  .gl-stat { color: var(--green-lt); }
  .gl-sep  { color: var(--muted); opacity: .45; }

  /* ── Solar imagery ── */
  #solar-imagery { padding-top: 0; }
  .imagery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 28px;
  }
  .img-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    margin: 0;
    transition: border-color .18s;
  }
  .img-card:hover { border-color: var(--green-dk); }
  .img-wrap {
    aspect-ratio: 1;
    background: #060e1a;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .solar-img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .img-card figcaption {
    padding: 10px 12px 12px;
    font-size: .73rem;
    color: var(--muted);
    line-height: 1.5;
  }
  @media (max-width: 640px) {
    .imagery-grid { grid-template-columns: 1fr; }
  }

  /* ── Band conditions — :global() because tiles are injected via innerHTML ── */
  :global(.band-grid) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 24px;
  }
  @media (max-width: 480px) {
    :global(.band-grid) { grid-template-columns: repeat(2, 1fr); }
  }
  :global(.band-tile) {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px 14px 14px;
    transition: border-color .18s, background .18s;
  }
  :global(.band-tile.bc-excellent) { border-color: #10b981; background: rgba(16,185,129,.07); }
  :global(.band-tile.bc-good)      { border-color: #34d399; background: rgba(52,211,153,.05); }
  :global(.band-tile.bc-fair)      { border-color: #fbbf24; background: rgba(251,191,36,.05); }
  :global(.band-tile.bc-poor)      { border-color: #f87171; background: rgba(248,113,113,.05); }
  :global(.band-tile.bc-closed)    { border-color: #1e293b; }
  :global(.bt-top) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 14px;
  }
  :global(.bt-band) {
    font-family: var(--mono);
    font-size: .95rem;
    font-weight: 700;
    letter-spacing: .04em;
    color: var(--text);
  }
  :global(.bt-label) {
    font-size: .6rem;
    font-family: var(--mono);
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  :global(.bc-excellent .bt-label) { color: #10b981; }
  :global(.bc-good      .bt-label) { color: #34d399; }
  :global(.bc-fair      .bt-label) { color: #fbbf24; }
  :global(.bc-poor      .bt-label) { color: #f87171; }
  :global(.bc-closed    .bt-label) { color: #334155; }
  /* S-meter bars */
  :global(.bt-bars) {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 22px;
  }
  :global(.bt-seg) {
    flex: 1;
    border-radius: 2px 2px 1px 1px;
    background: #1e293b;
  }
  :global(.bt-seg:nth-child(1)) { height: 28%; }
  :global(.bt-seg:nth-child(2)) { height: 46%; }
  :global(.bt-seg:nth-child(3)) { height: 64%; }
  :global(.bt-seg:nth-child(4)) { height: 81%; }
  :global(.bt-seg:nth-child(5)) { height: 100%; }
  :global(.bc-excellent .bt-seg.on) { background: #10b981; }
  :global(.bc-good      .bt-seg.on) { background: #34d399; }
  :global(.bc-fair      .bt-seg.on) { background: #fbbf24; }
  :global(.bc-poor      .bt-seg.on) { background: #f87171; }
  :global(.bc-closed    .bt-seg.on) { background: #334155; }
</style>

<script>
  /* ── Types ── */
  interface SolarData {
    updated: string;
    sfi: number | null;
    k_index: number | null;
    k_index_time: string | null;
    a_index: number | null;
    xray_class: string | null;
    xray_flux: number | null;
    xray_time: string | null;
    alerts: Array<{ issue_datetime: string; product_id: string; headline: string }>;
  }

  interface HistoryRow {
    recorded_at: string;
    sfi: number | null;
    k_index: number | null;
    a_index: number | null;
    xray_class: string | null;
  }

  /* ── Module state ── */
  let lastData: SolarData | null = null;
  let currentHours = 24;
  let nextRefreshAt = Date.now() + 10 * 60_000;
  let bcOffset = 0;

  /* ── Live tile helpers ── */
  function setTile(tileId: string, valueId: string, text: string, cls: string | null) {
    const tile = document.getElementById(tileId);
    const val  = document.getElementById(valueId);
    if (val)  val.textContent = text;
    if (tile) {
      tile.classList.remove('good', 'warn', 'bad');
      if (cls) tile.classList.add(cls);
    }
  }

  function sfiCls(v: number | null)  { if (v === null) return null; return v >= 150 ? 'good' : v >= 100 ? 'warn' : null; }
  function kpCls(v: number | null)   { if (v === null) return null; return v <= 2 ? 'good' : v <= 4 ? 'warn' : 'bad'; }
  function apCls(v: number | null)   { if (v === null) return null; return v <= 7 ? 'good' : v <= 24 ? 'warn' : 'bad'; }
  function xrayCls(s: string | null) { if (!s) return null; const l = s[0].toUpperCase(); return (l === 'A' || l === 'B') ? 'good' : l === 'C' ? 'warn' : 'bad'; }

  function relTime(iso: string): string {
    const diff = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
    if (diff < 60) return 'just now';
    if (diff < 3600) return `${Math.floor(diff / 60)} min ago`;
    return `${Math.floor(diff / 3600)} hr ago`;
  }

  function updateTimestamp(): void {
    const upEl = document.getElementById('data-updated');
    if (!upEl || !lastData?.updated) return;
    const nx = new Date(nextRefreshAt);
    const hh = String(nx.getUTCHours()).padStart(2, '0');
    const mm = String(nx.getUTCMinutes()).padStart(2, '0');
    upEl.textContent = `Data from NOAA SWPC · ${relTime(lastData.updated)} · next refresh ~${hh}:${mm} UTC`;
  }

  /* ── Storm alert banner ── */
  const G_SCALE: Record<number, [string, string]> = {
    5: ['G1', 'Minor'], 6: ['G2', 'Moderate'], 7: ['G3', 'Strong'], 8: ['G4', 'Severe'], 9: ['G5', 'Extreme'],
  };

  function updateStormBanner(d: SolarData): void {
    const banner  = document.getElementById('storm-banner') as HTMLElement | null;
    const textEl  = document.getElementById('sb-text');
    if (!banner || !textEl) return;

    const kp       = d.k_index ?? 0;
    const hasAlert = d.alerts.length > 0;

    if (kp < 5 && !hasAlert) {
      banner.hidden = true;
      sessionStorage.removeItem('sb-dismissed-kp');
      return;
    }

    // Respect dismiss unless Kp has risen to the next integer threshold
    const dismissedKp = Number(sessionStorage.getItem('sb-dismissed-kp') ?? '0');
    if (dismissedKp > 0 && Math.floor(kp) <= dismissedKp) return;

    const gKey  = Math.min(9, Math.max(5, Math.floor(kp)));
    const [gLabel, sevLabel] = G_SCALE[gKey] ?? ['G1', 'Minor'];
    const severe = kp >= 7;
    banner.classList.toggle('sb-severe', severe);

    let msg = '';
    if (kp >= 5) {
      msg = `Geomagnetic storm · Kp ${kp} · ${gLabel} (${sevLabel}) — HF polar paths disrupted`;
      if (kp >= 7) msg += '; aurora visible at mid-latitudes';
      msg += '.';
    }
    if (hasAlert) {
      const n    = d.alerts.length;
      const tail = `${n} active NOAA alert${n > 1 ? 's' : ''}: ${d.alerts[0].headline}`;
      msg = msg ? `${msg} ${tail}` : tail;
    }

    textEl.textContent = msg;
    banner.hidden = false;
  }

  /* ── Propagation summaries ── */
  function hfText(sfi: number | null, kp: number | null): string {
    if (sfi === null) return 'Solar flux data unavailable — check back shortly.';
    let t: string;
    if      (sfi >= 150) t = `SFI ${sfi} — outstanding. 10 m and 15 m wide open worldwide. Great time for DX.`;
    else if (sfi >= 120) t = `SFI ${sfi} — good. 15 m and 17 m open regionally; 10 m spotty but worth a listen.`;
    else if (sfi >=  90) t = `SFI ${sfi} — moderate. 20 m and 17 m most reliable. 10 m unlikely outside sporadic-E.`;
    else                 t = `SFI ${sfi} — low. Stick to 40 m and 80 m for reliable DX. 20 m marginal.`;
    if (kp !== null && kp >= 5) t += ' Geomagnetic storm active — polar paths disrupted.';
    else if (kp !== null && kp >= 3) t += ' Minor disturbance — watch high-latitude paths.';
    return t;
  }

  function geoText(kp: number | null, ap: number | null): string {
    if (kp === null) return 'Geomagnetic data unavailable — check back shortly.';
    let t: string;
    if      (kp <= 2) t = `Kp ${kp} — quiet. Excellent conditions, stable polar paths.`;
    else if (kp <= 4) t = `Kp ${kp} — unsettled. Minor disturbance; high-latitude paths may be affected.`;
    else if (kp <= 6) t = `Kp ${kp} — storm. Significant HF degradation; aurora possible at mid-latitudes.`;
    else              t = `Kp ${kp} — severe storm. HF largely unreliable; aurora visible far south.`;
    if (ap !== null) t += ` Ap: ${ap}.`;
    return t;
  }

  function solarText(xclass: string | null, alerts: SolarData['alerts']): string {
    let t = '';
    if (xclass) {
      const l = xclass[0].toUpperCase();
      if      (l === 'X') t = `Active X-class flare — ${xclass}. Possible HF blackout on the sunlit side; watch for CME.`;
      else if (l === 'M') t = `M-class flare — ${xclass}. Minor HF radio fade possible on the sunlit side.`;
      else if (l === 'C') t = `C-class flare — ${xclass}. Minor event, no significant HF impact expected.`;
      else                t = `Background X-ray: ${xclass}. No significant flare activity.`;
    } else {
      t = 'X-ray data unavailable.';
    }
    if (alerts.length > 0) t += ` ${alerts.length} active NOAA alert${alerts.length > 1 ? 's' : ''}: ${alerts[0].headline}`;
    return t;
  }

  function overallSummary(d: SolarData): string {
    const sw = d.sfi === null ? '' : d.sfi >= 150 ? 'excellent solar flux' : d.sfi >= 120 ? 'good solar flux' : d.sfi >= 90 ? 'moderate solar flux' : 'low solar flux';
    const kw = d.k_index === null ? '' : d.k_index <= 2 ? 'quiet geomagnetic conditions' : d.k_index <= 4 ? 'unsettled geomagnetic conditions' : 'active geomagnetic storm';
    if (sw && kw) return `Current conditions: ${sw} and ${kw}.`;
    return sw ? `Current conditions: ${sw}.` : kw ? `Current conditions: ${kw}.` : 'Solar data not yet available — populates on the first cron cycle.';
  }

  /* ── Band conditions ── */
  const HF_BANDS: Array<{band: string; mhz: number}> = [
    { band: '160 m', mhz: 1.8  },
    { band: '80 m',  mhz: 3.5  },
    { band: '40 m',  mhz: 7.0  },
    { band: '30 m',  mhz: 10.1 },
    { band: '20 m',  mhz: 14.0 },
    { band: '17 m',  mhz: 18.1 },
    { band: '15 m',  mhz: 21.0 },
    { band: '12 m',  mhz: 24.9 },
    { band: '10 m',  mhz: 28.0 },
  ];
  const BC_LABELS  = ['Closed', 'Poor', 'Fair', 'Good', 'Excellent'];
  const BC_CLASSES = ['bc-closed', 'bc-poor', 'bc-fair', 'bc-good', 'bc-excellent'];

  function calcBandScore(mhz: number, sfiVal: number, kpVal: number, isDay: boolean): number {
    const k = kpVal;
    const s = sfiVal;
    let sc = 0;
    if (mhz <= 2.5) {          // 160 m — D-layer absorbs by day; K-noise hurts at night
      sc = isDay ? (k <= 2 ? 2 : k <= 4 ? 1 : 0) : (k <= 2 ? 3 : k <= 4 ? 2 : 1);
    } else if (mhz <= 5) {     // 80 m
      sc = isDay ? (k <= 2 ? 2 : 1) : (k <= 2 ? 4 : k <= 4 ? 3 : 1);
    } else if (mhz <= 8) {     // 40 m — nighttime DX, daytime regional
      sc = isDay ? (k <= 2 ? 3 : k <= 4 ? 2 : 1) : (k <= 2 ? 4 : k <= 4 ? 3 : 2);
    } else if (mhz <= 12) {    // 30 m — reliable anytime; MUF rarely an issue
      sc = k <= 2 ? 4 : k <= 4 ? 3 : k <= 6 ? 2 : 1;
    } else if (mhz <= 15) {    // 20 m — workhorse DX
      sc = k <= 2 ? 4 : k <= 4 ? 3 : k <= 6 ? 2 : 0;
    } else if (mhz <= 19) {    // 17 m — WARC; needs moderate SFI
      if      (s >= 130) sc = k <= 2 ? 4 : k <= 4 ? 3 : 1;
      else if (s >= 100) sc = k <= 2 ? 3 : k <= 4 ? 2 : 1;
      else if (s >=  80) sc = k <= 2 ? 2 : 1;
      else               sc = 0;
    } else if (mhz <= 22) {    // 15 m
      if      (s >= 150) sc = k <= 2 ? 4 : k <= 4 ? 3 : 1;
      else if (s >= 120) sc = k <= 2 ? 3 : k <= 4 ? 2 : 1;
      else if (s >=  95) sc = k <= 2 ? 2 : 1;
      else               sc = 0;
    } else if (mhz <= 26) {    // 12 m
      if      (s >= 160) sc = k <= 2 ? 4 : k <= 4 ? 3 : 1;
      else if (s >= 135) sc = k <= 2 ? 3 : k <= 4 ? 2 : 0;
      else if (s >= 110) sc = k <= 2 ? 2 : 0;
      else               sc = 0;
    } else {                   // 10 m
      if      (s >= 160) sc = k <= 2 ? 4 : k <= 4 ? 3 : 1;
      else if (s >= 140) sc = k <= 2 ? 3 : k <= 4 ? 2 : 0;
      else if (s >= 120) sc = k <= 2 ? 2 : 0;
      else               sc = 0;
    }
    return Math.max(0, Math.min(4, sc));
  }

  function renderBandGrid(sfi: number | null, kp: number | null, offsetHours = 0): void {
    const grid = document.getElementById('band-grid');
    if (!grid) return;
    const sfiVal = sfi ?? 70;
    const kpVal  = kp  ?? 0;
    const sim    = new Date(Date.now() + offsetHours * 3600_000);
    const utcH   = sim.getUTCHours() + sim.getUTCMinutes() / 60;
    const isDay  = utcH >= 6 && utcH < 20;

    // Filled segments per score: 0=0, 1=1, 2=2, 3=3, 4=5 (skip to full for Excellent)
    const FILLED = [0, 1, 2, 3, 5];

    grid.innerHTML = HF_BANDS.map(({ band, mhz }) => {
      const sc     = calcBandScore(mhz, sfiVal, kpVal, isDay);
      const cls    = BC_CLASSES[sc];
      const lbl    = BC_LABELS[sc];
      const filled = FILLED[sc];
      const segs   = Array.from({ length: 5 }, (_, i) =>
        `<div class="bt-seg${i < filled ? ' on' : ''}"></div>`
      ).join('');
      return `<div class="band-tile ${cls}">
        <div class="bt-top">
          <span class="bt-band">${band}</span>
          <span class="bt-label">${lbl}</span>
        </div>
        <div class="bt-bars">${segs}</div>
      </div>`;
    }).join('');

    const basisEl = document.getElementById('band-basis');
    if (basisEl) {
      const parts: string[] = [];
      if (sfi !== null) parts.push(`SFI ${sfi}`);
      if (kp  !== null) parts.push(`Kp ${kp}`);
      if (offsetHours !== 0) {
        const hh = String(sim.getUTCHours()).padStart(2, '0');
        const mm = String(sim.getUTCMinutes()).padStart(2, '0');
        parts.push(`${offsetHours > 0 ? '+' : ''}${offsetHours}h · UTC ${hh}:${mm}`);
      } else {
        parts.push(isDay ? 'daytime UTC' : 'nighttime UTC');
      }
      basisEl.textContent = `Estimates based on ${parts.join(', ')}.`;
    }
  }

  /* ── Greyline map ── */
  function getDayOfYear(d: Date): number {
    return Math.floor((d.getTime() - Date.UTC(d.getUTCFullYear(), 0, 0)) / 86400_000);
  }

  // Preload the world map base image once
  const _worldMapImg = new Image();
  _worldMapImg.src = '/world-map.svg';

  function drawGreyline(offsetHours = 0): void {
    const canvas = document.getElementById('gl-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const W = 720, H = 360;
    canvas.width = W; canvas.height = H;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const sim    = new Date(Date.now() + offsetHours * 3600_000);
    const doy    = getDayOfYear(sim);
    const utcF   = sim.getUTCHours() + sim.getUTCMinutes() / 60 + sim.getUTCSeconds() / 3600;
    const decRad = 23.4397 * (Math.PI / 180) * Math.sin(2 * Math.PI * (doy - 81) / 365);
    const lonSSRad = (12 - utcF) * 15 * (Math.PI / 180);

    function paint(baseImg: HTMLImageElement | null) {
      // Ocean background
      ctx!.fillStyle = '#0a1e33';
      ctx!.fillRect(0, 0, W, H);

      // Land masses from pre-generated world map SVG
      if (baseImg?.complete && baseImg.naturalWidth > 0) {
        ctx!.drawImage(baseImg, 0, 0, W, H);
      }

      // Night + twilight overlay via offscreen canvas so day-side alpha=0
      // pixels don't erase the land we just drew
      const overlay = document.createElement('canvas');
      overlay.width = W; overlay.height = H;
      const octx = overlay.getContext('2d')!;
      const imgData = octx.createImageData(W, H);
      const d = imgData.data;
      for (let px = 0; px < W; px++) {
        for (let py = 0; py < H; py++) {
          const lon = (px / W - 0.5) * 2 * Math.PI;
          const lat = (0.5 - py / H) * Math.PI;
          const dot = Math.sin(lat) * Math.sin(decRad) + Math.cos(lat) * Math.cos(decRad) * Math.cos(lon - lonSSRad);
          const i = (py * W + px) * 4;
          if (dot < -0.07) {
            d[i] = 3; d[i+1] = 8; d[i+2] = 16; d[i+3] = 210;
          } else if (dot < 0.07) {
            const t = (dot + 0.07) / 0.14;
            d[i] = 3; d[i+1] = 8; d[i+2] = 16;
            d[i+3] = Math.round(210 - t * 210);
          }
        }
      }
      octx.putImageData(imgData, 0, 0);
      ctx!.drawImage(overlay, 0, 0);

      // Graticule every 30°
      ctx!.strokeStyle = 'rgba(255,255,255,0.07)';
      ctx!.lineWidth = 1;
      for (let lon = -180; lon <= 180; lon += 30) {
        const x = ((lon + 180) / 360) * W;
        ctx!.beginPath(); ctx!.moveTo(x, 0); ctx!.lineTo(x, H); ctx!.stroke();
      }
      for (let lat = -90; lat <= 90; lat += 30) {
        const y = (0.5 - lat / 180) * H;
        ctx!.beginPath(); ctx!.moveTo(0, y); ctx!.lineTo(W, y); ctx!.stroke();
      }

      // Equator (brighter)
      ctx!.strokeStyle = 'rgba(255,255,255,0.17)';
      ctx!.lineWidth = 1;
      ctx!.beginPath(); ctx!.moveTo(0, H / 2); ctx!.lineTo(W, H / 2); ctx!.stroke();

      // Tropics (dashed amber)
      ctx!.strokeStyle = 'rgba(251,191,36,0.25)';
      ctx!.setLineDash([5, 5]);
      for (const tlat of [23.4397, -23.4397]) {
        const ty = (0.5 - tlat / 180) * H;
        ctx!.beginPath(); ctx!.moveTo(0, ty); ctx!.lineTo(W, ty); ctx!.stroke();
      }
      ctx!.setLineDash([]);

      // Subsolar point
      const lonSSDeg = lonSSRad * (180 / Math.PI);
      const latSSDeg = decRad  * (180 / Math.PI);
      const ssX = ((lonSSDeg + 180 + 360) % 360 / 360) * W;
      const ssY = (0.5 - latSSDeg / 180) * H;
      ctx!.fillStyle = 'rgba(251,191,36,0.25)';
      ctx!.beginPath(); ctx!.arc(ssX, ssY, 14, 0, 2 * Math.PI); ctx!.fill();
      ctx!.fillStyle = '#fbbf24';
      ctx!.beginPath(); ctx!.arc(ssX, ssY, 5, 0, 2 * Math.PI); ctx!.fill();

      // Info strip
      const hh  = String(sim.getUTCHours()).padStart(2, '0');
      const mm  = String(sim.getUTCMinutes()).padStart(2, '0');
      const lat = Math.abs(latSSDeg).toFixed(1) + '° ' + (latSSDeg >= 0 ? 'N' : 'S');
      const lon = Math.abs(lonSSDeg).toFixed(1) + '° ' + (lonSSDeg >= 0 ? 'E' : 'W');
      const glUtc = document.getElementById('gl-utc');
      const glSun = document.getElementById('gl-sun');
      if (glUtc) glUtc.textContent = offsetHours !== 0
        ? `${offsetHours > 0 ? '+' : ''}${offsetHours}h · UTC ${hh}:${mm}`
        : `UTC ${hh}:${mm}`;
      if (glSun) glSun.textContent = `subsolar: ${lat}, ${lon}`;
    }

    if (_worldMapImg.complete && _worldMapImg.naturalWidth > 0) {
      paint(_worldMapImg);
    } else {
      _worldMapImg.onload = () => paint(_worldMapImg);
      _worldMapImg.onerror = () => paint(null);
    }
  }

  /* ── Solar imagery ── */
  function refreshImages(): void {
    const t = Math.floor(Date.now() / (15 * 60_000));
    const imgs: Array<[string, string]> = [
      ['img-aia193', `https://sdo.gsfc.nasa.gov/assets/img/latest/latest_256_0193.jpg?t=${t}`],
      ['img-hmi',    `https://sdo.gsfc.nasa.gov/assets/img/latest/latest_256_HMIIC.jpg?t=${t}`],
      ['img-lasco',  `https://soho.nascom.nasa.gov/data/realtime/c3/512/latest.jpg?t=${t}`],
    ];
    imgs.forEach(([id, url]) => {
      const el = document.getElementById(id) as HTMLImageElement | null;
      if (!el) return;
      el.onerror = () => {
        const wrap = el.closest('.img-wrap');
        if (wrap) wrap.innerHTML = '<span style="color:#475569;font-family:var(--mono);font-size:.7rem;padding:12px;text-align:center;display:block">Image unavailable</span>';
      };
      el.src = url;
    });
  }

  /* ── Load live data ── */
  async function loadSolar() {
    try {
      const res = await fetch('/api/solar');
      if (!res.ok) {
        const s = document.getElementById('conditions-summary');
        if (s) s.textContent = 'Solar data not yet available — the cron worker will populate this on its first 15-minute cycle.';
        ['card-hf', 'card-geo', 'card-solar'].forEach(id => {
          const el = document.getElementById(id);
          if (el) el.textContent = 'No data yet.';
        });
        renderBandGrid(null, null);
        return;
      }
      const d: SolarData = await res.json();

      setTile('tile-sfi',    'val-sfi',    d.sfi     !== null ? String(d.sfi)     : '—', sfiCls(d.sfi));
      setTile('tile-aindex', 'val-aindex', d.a_index !== null ? String(d.a_index) : '—', apCls(d.a_index));
      setTile('tile-kindex', 'val-kindex', d.k_index !== null ? String(d.k_index) : '—', kpCls(d.k_index));
      setTile('tile-xray',   'val-xray',   d.xray_class ?? '—',                          xrayCls(d.xray_class));

      renderBandGrid(d.sfi, d.k_index, bcOffset);

      const sumEl = document.getElementById('conditions-summary');
      if (sumEl) sumEl.textContent = overallSummary(d);

      const hfEl  = document.getElementById('card-hf');    if (hfEl)  hfEl.textContent  = hfText(d.sfi, d.k_index);
      const geoEl = document.getElementById('card-geo');   if (geoEl) geoEl.textContent  = geoText(d.k_index, d.a_index);
      const solEl = document.getElementById('card-solar'); if (solEl) solEl.textContent  = solarText(d.xray_class, d.alerts);

      lastData = d;
      nextRefreshAt = Date.now() + 10 * 60_000;
      updateTimestamp();
      updateStormBanner(d);
    } catch (e) {
      console.error('solar fetch failed', e);
      const s = document.getElementById('conditions-summary');
      if (s) s.textContent = 'Unable to load solar data. Please try again later.';
    }
  }

  /* ── Sparkline renderer ── */
  function sparkline(
    svgId: string,
    rows: HistoryRow[],
    key: 'sfi' | 'k_index',
    yMin: number,
    yMax: number,
    color: string,
    refLine?: number
  ) {
    const el = document.getElementById(svgId) as SVGSVGElement | null;
    if (!el) return;
    const W = 560, H = 80;
    const valid = rows.filter(r => r[key] !== null && r[key] !== undefined);

    if (valid.length < 2) {
      el.innerHTML = `<text x="${W / 2}" y="${H / 2 + 4}" text-anchor="middle" fill="#475569" font-size="11" font-family="monospace">no data yet</text>`;
      return;
    }

    const xOf = (i: number) => ((i / (valid.length - 1)) * W).toFixed(1);
    const yOf = (v: number)  => Math.max(0, Math.min(H, H - ((v - yMin) / (yMax - yMin)) * H)).toFixed(1);

    let html = '';

    // Subtle grid lines
    for (let i = 0; i <= 4; i++) {
      const y = ((i / 4) * H).toFixed(1);
      html += `<line x1="0" y1="${y}" x2="${W}" y2="${y}" stroke="#1e293b" stroke-width="1"/>`;
    }

    // Storm reference line (K-index: K=5)
    if (refLine !== undefined) {
      const ry = parseFloat(yOf(refLine));
      if (ry >= 0 && ry <= H) {
        html += `<line x1="0" y1="${ry}" x2="${W}" y2="${ry}" stroke="#f87171" stroke-width="1" stroke-dasharray="4 3" opacity="0.55"/>`;
      }
    }

    // Area fill
    const pts = valid.map((r, i) => `${xOf(i)},${yOf(Number(r[key]))}`).join(' ');
    html += `<polygon points="0,${H} ${pts} ${xOf(valid.length - 1)},${H}" fill="${color}" opacity="0.1"/>`;

    // Line
    html += `<polyline points="${pts}" fill="none" stroke="${color}" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>`;

    // Dot at latest reading
    const lv = Number(valid[valid.length - 1][key]);
    html += `<circle cx="${xOf(valid.length - 1)}" cy="${yOf(lv)}" r="3.5" fill="${color}" stroke="#0f172a" stroke-width="2"/>`;

    el.innerHTML = html;
  }

  function trendArrow(rows: HistoryRow[], key: 'sfi' | 'k_index'): string {
    const vals = rows.filter(r => r[key] !== null).map(r => Number(r[key]));
    if (vals.length < 4) return '';
    const delta = vals[vals.length - 1] - vals[0];
    const threshold = key === 'sfi' ? 5 : 0.5;
    return Math.abs(delta) < threshold ? '' : delta > 0 ? ' ↑' : ' ↓';
  }

  function fmtStartTime(iso: string, hours: number): string {
    const d = new Date(iso);
    if (hours <= 24) return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    return d.toLocaleDateString([], { month: 'short', day: 'numeric' });
  }

  /* ── Load history ── */
  async function loadHistory(hours: number) {
    // Update tab state
    document.querySelectorAll('.range-tab').forEach(btn => {
      (btn as HTMLElement).classList.toggle('active', Number((btn as HTMLElement).dataset.hours) === hours);
    });

    const labelEl = document.getElementById('history-label');
    if (labelEl) labelEl.textContent = hours === 168 ? '7-Day History' : hours === 6 ? '6-Hour History' : '24-Hour History';

    try {
      const res = await fetch(`/api/history?hours=${hours}`);
      if (!res.ok) throw new Error(String(res.status));
      const rows: HistoryRow[] = await res.json();

      if (!rows.length) {
        ['chart-sfi', 'chart-kp'].forEach(id => {
          const el = document.getElementById(id);
          if (el) el.innerHTML = '<text x="280" y="44" text-anchor="middle" fill="#475569" font-size="11" font-family="monospace">no data yet — first reading within 15 min</text>';
        });
        return;
      }

      // SFI — auto-scaled y-axis
      const sfis = rows.filter(r => r.sfi !== null).map(r => Number(r.sfi));
      const sfiMin = sfis.length ? Math.max(0, Math.floor(Math.min(...sfis) - 10)) : 60;
      const sfiMax = sfis.length ? Math.ceil(Math.max(...sfis) + 10) : 250;
      sparkline('chart-sfi', rows, 'sfi', sfiMin, sfiMax, '#10b981');

      // K-index — fixed 0–9
      sparkline('chart-kp', rows, 'k_index', 0, 9, '#10b981', 5);

      // Current value + trend in chart headers
      const latestSfi = sfis[sfis.length - 1];
      const sfiCurEl = document.getElementById('chart-sfi-cur');
      if (sfiCurEl && latestSfi !== undefined) sfiCurEl.textContent = String(latestSfi) + trendArrow(rows, 'sfi');

      const kps = rows.filter(r => r.k_index !== null).map(r => Number(r.k_index));
      const kpCurEl = document.getElementById('chart-kp-cur');
      if (kpCurEl && kps.length) kpCurEl.textContent = String(kps[kps.length - 1]) + trendArrow(rows, 'k_index');

      // Footer start-time labels
      const startIso = rows[0].recorded_at;
      const startFmt = fmtStartTime(startIso, hours);
      (['chart-sfi-start', 'chart-kp-start'] as const).forEach(id => {
        const el = document.getElementById(id);
        if (el) el.textContent = startFmt;
      });

      const histEl = document.getElementById('history-updated');
      if (histEl) histEl.textContent = `${rows.length} readings`;
    } catch (e) {
      console.error('history fetch failed', e);
    }
  }

  /* ── Init ── */
  document.getElementById('sb-close')?.addEventListener('click', () => {
    const banner = document.getElementById('storm-banner') as HTMLElement | null;
    if (banner) {
      banner.hidden = true;
      sessionStorage.setItem('sb-dismissed-kp', String(Math.floor(lastData?.k_index ?? 0)));
    }
  });

  // Band conditions time slider
  function applyBcOffset(offset: number): void {
    bcOffset = offset;
    const sim = new Date(Date.now() + offset * 3600_000);
    const hh  = String(sim.getUTCHours()).padStart(2, '0');
    const mm  = String(sim.getUTCMinutes()).padStart(2, '0');
    const disp = document.getElementById('bc-time-display');
    const rst  = document.getElementById('bc-reset') as HTMLButtonElement | null;
    if (disp) disp.textContent = offset === 0 ? `Now · UTC ${hh}:${mm}` : `${offset > 0 ? '+' : ''}${offset}h · UTC ${hh}:${mm}`;
    if (rst)  rst.hidden = offset === 0;
    renderBandGrid(lastData?.sfi ?? null, lastData?.k_index ?? null, offset);
    drawGreyline(offset);
  }

  const bcSlider = document.getElementById('bc-offset') as HTMLInputElement | null;
  bcSlider?.addEventListener('input', () => applyBcOffset(Number(bcSlider.value)));
  document.getElementById('bc-reset')?.addEventListener('click', () => {
    if (bcSlider) { bcSlider.value = '0'; applyBcOffset(0); }
  });

  document.querySelectorAll('.range-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      const h = Number((btn as HTMLElement).dataset.hours);
      if (h) { currentHours = h; loadHistory(h); }
    });
  });

  // Update "X min ago" label and greyline every minute
  setInterval(() => { updateTimestamp(); drawGreyline(bcOffset); }, 60_000);

  // Auto-reload data every 10 minutes
  setInterval(() => {
    nextRefreshAt = Date.now() + 10 * 60_000;
    loadSolar();
    loadHistory(currentHours);
  }, 10 * 60_000);

  // Refresh solar images every 15 minutes
  setInterval(refreshImages, 15 * 60_000);

  loadSolar();
  loadHistory(24);
  drawGreyline(0);
  refreshImages();
</script>

<script>
  import {
    Chart,
    LineController, BarController,
    CategoryScale, LinearScale,
    PointElement, LineElement, BarElement,
    Tooltip, Filler,
  } from 'chart.js';

  Chart.register(
    LineController, BarController,
    CategoryScale, LinearScale,
    PointElement, LineElement, BarElement,
    Tooltip, Filler,
  );

  // Dark-theme defaults
  Chart.defaults.color = '#94a3b8';
  Chart.defaults.borderColor = '#334155';
  Chart.defaults.font.family = "'JetBrains Mono', ui-monospace, monospace";
  Chart.defaults.font.size = 10;

  type ChartSeries = { labels: string[]; values: number[] };

  const charts: Record<string, Chart> = {};

  function shortLabel(bucket: string): string {
    if (bucket.includes('T')) {
      // 3-hour bucket: "2024-01-15T12:00:00Z" → "Jan 15 12:00"
      const d = new Date(bucket);
      return d.toLocaleDateString([], { month: 'short', day: 'numeric' }) + ' ' +
             d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }
    // Daily: "2024-01-15" → "Jan 15"
    const [, m, day] = bucket.split('-');
    const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    return `${months[parseInt(m) - 1]} ${parseInt(day)}`;
  }

  function makeLineChart(id: string, data: ChartSeries, color: string, refY?: number): Chart {
    const canvas = document.getElementById(id) as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const labels = data.labels.map(shortLabel);

    // Gradient fill
    const grad = ctx.createLinearGradient(0, 0, 0, 140);
    grad.addColorStop(0, color + '33');
    grad.addColorStop(1, color + '00');

    const datasets: any[] = [
      {
        data: data.values,
        borderColor: color,
        backgroundColor: grad,
        borderWidth: 2,
        pointRadius: data.labels.length < 20 ? 3 : 0,
        pointHoverRadius: 4,
        fill: true,
        tension: 0.3,
      },
    ];

    if (refY !== undefined) {
      datasets.push({
        data: Array(data.labels.length).fill(refY),
        borderColor: '#f8717155',
        borderWidth: 1,
        borderDash: [4, 3],
        pointRadius: 0,
        fill: false,
      });
    }

    return new Chart(ctx, {
      type: 'line',
      data: { labels, datasets },
      options: {
        responsive: false,
        animation: false,
        plugins: { tooltip: { mode: 'index', intersect: false }, legend: { display: false } },
        scales: {
          x: { grid: { color: '#1e293b' }, ticks: { maxTicksLimit: 8, maxRotation: 0 } },
          y: { grid: { color: '#1e293b' }, ticks: { maxTicksLimit: 5 } },
        },
      },
    });
  }

  function makeKpChart(id: string, obs: ChartSeries, fcst: Array<{ t: string; v: number }>): Chart {
    const canvas = document.getElementById(id) as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;

    const obsLabels = obs.labels.map(shortLabel);
    const obsNow = obs.labels.length > 0 ? obs.labels[obs.labels.length - 1] : '';
    const fcstFuture = fcst.filter(f => f.t > obsNow);
    const fcstLabels = fcstFuture.map(f => shortLabel(f.t));
    const fcstVals = fcstFuture.map(f => f.v);

    const allLabels = [...obsLabels, ...fcstLabels];
    const obsData = [...obs.values, ...Array(fcstLabels.length).fill(null)];
    const fcstData = [...Array(obsLabels.length).fill(null), ...fcstVals];

    function kpColor(v: number | null): string {
      if (v === null) return '#334155';
      if (v <= 2) return '#10b981';
      if (v <= 4) return '#fbbf24';
      return '#f87171';
    }

    return new Chart(ctx, {
      type: 'bar',
      data: {
        labels: allLabels,
        datasets: [
          {
            label: 'Kp observed',
            type: 'bar',
            data: obsData,
            backgroundColor: obs.values.map(kpColor),
            borderWidth: 0,
            barPercentage: 0.9,
          },
          {
            label: 'Kp forecast',
            type: 'line',
            data: fcstData,
            borderColor: '#6ee7b7',
            borderWidth: 2,
            borderDash: [5, 3],
            pointRadius: fcstLabels.length < 20 ? 3 : 0,
            pointBackgroundColor: '#6ee7b7',
            fill: false,
            tension: 0.3,
          },
          {
            label: 'Storm threshold',
            type: 'line',
            data: Array(allLabels.length).fill(5),
            borderColor: '#f8717155',
            borderWidth: 1,
            borderDash: [4, 3],
            pointRadius: 0,
            fill: false,
          },
        ] as any[],
      },
      options: {
        responsive: false,
        animation: false,
        plugins: { tooltip: { mode: 'index', intersect: false }, legend: { display: false } },
        scales: {
          x: { grid: { color: '#1e293b' }, ticks: { maxTicksLimit: 8, maxRotation: 0 } },
          y: { min: 0, max: 9, grid: { color: '#1e293b' }, ticks: { maxTicksLimit: 5 } },
        },
      },
    });
  }

  function parseForecast(raw: any): Array<{ t: string; v: number }> {
    if (!Array.isArray(raw) || !raw.length) return [];
    // New object format: [{time_tag, kp, ...}, ...]
    if (typeof raw[0] === 'object' && !Array.isArray(raw[0])) {
      return raw
        .map((r: any) => ({ t: r.time_tag ?? '', v: parseFloat(r.kp ?? r.kp_predicted ?? '0') }))
        .filter((r: any) => r.t && !isNaN(r.v));
    }
    // Legacy 2D format: [["time_tag","kp",...], ["2024-...", "3.00", ...], ...]
    const [header, ...rows] = raw as string[][];
    const ti = header.indexOf('time_tag');
    const ki = header.findIndex((h: string) => /kp/i.test(h));
    if (ti < 0 || ki < 0) return [];
    return rows
      .map(r => ({ t: r[ti] ?? '', v: parseFloat(r[ki] ?? '0') }))
      .filter(r => r.t && !isNaN(r.v));
  }

  async function loadTrends() {
    // SFI
    const sfiData = await fetchSeries('sfi', 30);
    if (sfiData) charts['sfi'] = makeLineChart('canvas-sfi', sfiData, '#10b981');

    // K-index + forecast
    const [kpData, fcstRaw] = await Promise.all([
      fetchSeries('kindex', 7),
      fetch('/api/history?metric=kforecast').then(r => r.ok ? r.json() : null).catch(() => null),
    ]);
    const fcst = parseForecast(fcstRaw ?? []);
    if (kpData) charts['kp'] = makeKpChart('canvas-kp', kpData, fcst);

    // Sunspots
    const ssnData = await fetchSeries('sunspots', 30);
    if (ssnData) charts['ssn'] = makeLineChart('canvas-ssn', ssnData, '#6ee7b7');
  }

  async function fetchSeries(metric: string, days: number): Promise<ChartSeries | null> {
    try {
      const res = await fetch(`/api/history?metric=${metric}&days=${days}`);
      if (!res.ok) return null;
      const d: ChartSeries = await res.json();
      return d.labels?.length ? d : null;
    } catch {
      return null;
    }
  }

  async function reloadChart(chartKey: string, metric: string, days: number) {
    const data = await fetchSeries(metric, days);
    if (!data) return;
    const old = charts[chartKey];
    if (old) old.destroy();
    const color = chartKey === 'ssn' ? '#6ee7b7' : '#10b981';
    charts[chartKey] = makeLineChart(`canvas-${chartKey}`, data, color);
  }

  // Tab wiring
  document.querySelectorAll<HTMLButtonElement>('.tc-tab').forEach(btn => {
    btn.addEventListener('click', async () => {
      const chartKey = btn.dataset.chart!;
      const days = Number(btn.dataset.days);
      // Update tab active state within the same card
      btn.closest('.tc-tabs')!.querySelectorAll('.tc-tab').forEach(t => t.classList.remove('active'));
      btn.classList.add('active');
      await reloadChart(chartKey, chartKey === 'ssn' ? 'sunspots' : 'sfi', days);
    });
  });

  loadTrends();
</script>
