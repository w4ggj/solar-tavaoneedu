---
import Shell from '../layouts/Shell.astro';
---

<Shell
  title="Solar Dashboard — TavaOne Solar"
  description="Real-time solar flux, geomagnetic indices, and HF propagation data for amateur radio operators."
>
  <div id="storm-banner" class="storm-banner" hidden role="alert" aria-live="assertive">
    <div class="wrap sb-inner">
      <span class="sb-icon" aria-hidden="true">⚡</span>
      <span id="sb-text" class="sb-text"></span>
      <button id="sb-close" class="sb-close" type="button" aria-label="Dismiss alert">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <section class="page-hero" aria-label="Solar conditions">
    <div class="wrap">
      <p class="eyebrow">Live <span class="dim">· Updated every 15 min</span></p>
      <h1>Solar <span class="em">Conditions</span></h1>
      <p class="lede">Real-time solar flux, geomagnetic indices, and band propagation — built for amateur radio operators.</p>
    </div>
    <div class="signal" aria-hidden="true">
      <svg viewBox="0 0 1200 80" preserveAspectRatio="none">
        <g class="wave-grp" fill="none" stroke="#10b981" stroke-width="2" opacity="0.65">
          <path d="M -200,40 C -167,12 -133,12 -100,40 C -67,68 -33,68 0,40 C 33,12 67,12 100,40 C 133,68 167,68 200,40 C 233,12 267,12 300,40 C 333,68 367,68 400,40 C 433,12 467,12 500,40 C 533,68 567,68 600,40 C 633,12 667,12 700,40 C 733,68 767,68 800,40 C 833,12 867,12 900,40 C 933,68 967,68 1000,40 C 1033,12 1067,12 1100,40 C 1133,68 1167,68 1200,40 C 1233,12 1267,12 1300,40 C 1333,68 1367,68 1400,40 C 1433,12 1467,12 1500,40 C 1533,68 1567,68 1600,40 C 1633,12 1667,12 1700,40 C 1733,68 1767,68 1800,40 C 1833,12 1867,12 1900,40 C 1933,68 1967,68 2000,40 C 2033,12 2067,12 2100,40 C 2133,68 2167,68 2200,40"/>
        </g>
      </svg>
      <span class="tag">SOLAR</span>
    </div>
  </section>

  <section id="dashboard" aria-label="Live data">
    <div class="wrap">
      <p class="seclabel">Live Conditions</p>
      <h2>Current solar data</h2>
      <p class="sec-intro">Solar flux index, geomagnetic conditions, and X-ray flux — refreshed every 15 minutes from NOAA SWPC.</p>

      <div class="data-grid">
        <div class="data-tile" id="tile-sfi">
          <div class="dt-label">Solar Flux (SFI)</div>
          <div class="dt-value" id="val-sfi">—</div>
          <div class="dt-meta">10.7 cm radio flux</div>
        </div>
        <div class="data-tile" id="tile-aindex">
          <div class="dt-label">A-Index</div>
          <div class="dt-value" id="val-aindex">—</div>
          <div class="dt-meta">Geomagnetic Ap (3-hr)</div>
        </div>
        <div class="data-tile" id="tile-kindex">
          <div class="dt-label">K-Index</div>
          <div class="dt-value" id="val-kindex">—</div>
          <div class="dt-meta">Planetary Kp (real-time)</div>
        </div>
        <div class="data-tile" id="tile-xray">
          <div class="dt-label">X-Ray Class</div>
          <div class="dt-value" id="val-xray">—</div>
          <div class="dt-meta">GOES satellite</div>
        </div>
        <div class="data-tile" id="tile-protons">
          <div class="dt-label">Proton Flux</div>
          <div class="dt-value" id="val-protons">—</div>
          <div class="dt-meta">GOES &gt;10 MeV · <span id="val-protons-scale">S0</span></div>
        </div>
      </div>
      <p class="data-updated" id="data-updated"></p>

      <!-- NOAA storm scales from WWV/WWVH bulletin -->
      <div class="wwv-row" id="wwv-row" hidden>
        <span class="wwv-label">NOAA Scales</span>
        <div class="wwv-badges">
          <div class="wwv-badge" id="wb-r">
            <span class="wb-val" id="wb-r-val">R0</span>
            <span class="wb-lbl">Radio blackout</span>
          </div>
          <div class="wwv-badge" id="wb-s">
            <span class="wb-val" id="wb-s-val">S0</span>
            <span class="wb-lbl">Solar radiation</span>
          </div>
          <div class="wwv-badge" id="wb-g">
            <span class="wb-val" id="wb-g-val">G0</span>
            <span class="wb-lbl">Geomagnetic</span>
          </div>
        </div>
        <a href="https://www.swpc.noaa.gov/noaa-scales-explanation" target="_blank" rel="noopener" class="wwv-explain">What are NOAA scales? ↗</a>
      </div>

      <!-- Solar wind (DSCOVR real-time) -->
      <div class="sw-row" id="sw-row" hidden>
        <span class="wwv-label">Solar Wind</span>
        <div class="sw-badges">
          <div class="sw-badge" id="sw-bz-badge">
            <span class="sw-val" id="sw-bz">—</span>
            <span class="sw-sub">Bz (nT)</span>
          </div>
          <div class="sw-badge">
            <span class="sw-val" id="sw-speed">—</span>
            <span class="sw-sub">Speed km/s</span>
          </div>
          <div class="sw-badge">
            <span class="sw-val" id="sw-density">—</span>
            <span class="sw-sub">Density p/cm³</span>
          </div>
          <div class="sw-badge">
            <span class="sw-val" id="sw-bt">—</span>
            <span class="sw-sub">Bt (nT)</span>
          </div>
        </div>
        <canvas id="sw-bz-chart" class="sw-mini-chart" width="180" height="44" aria-label="Bz 1-hour trend"></canvas>
        <span class="sw-updated" id="sw-updated"></span>
      </div>

      <!-- Radio blackout indicator (derived from X-ray flux) -->
      <div class="rb-row" id="rb-row">
        <span class="wwv-label">Blackout</span>
        <div class="rb-badge rb-none" id="rb-badge">
          <span class="rb-scale" id="rb-scale">R0</span>
          <span class="rb-desc" id="rb-desc">No blackout</span>
        </div>
        <span class="rb-freqs" id="rb-freqs"></span>
      </div>

      <!-- Space weather cluster: aurora + 3-day outlook (hidden via CSS :has when both children are hidden) -->
      <div class="swx-cluster">
        <!-- Aurora visibility forecast (derived from live Kp) -->
        <div class="aurora-row" id="aurora-row" hidden>
          <span class="wwv-label">Aurora</span>
          <div class="aurora-badge" id="aurora-badge">
            <span class="aurora-icon" aria-hidden="true">🌌</span>
            <div class="aurora-vals">
              <span class="aurora-bound" id="aurora-bound">—°N</span>
              <span class="aurora-region" id="aurora-region">Calculating…</span>
            </div>
          </div>
        </div>

        <!-- 3-day space weather outlook + 24h flare probabilities -->
        <div class="swx-row" id="swx-row" hidden>
          <span class="wwv-label">3-Day Outlook</span>
          <div class="swx-inner">
            <div class="swx-days" id="swx-days"></div>
            <div class="swx-probs" id="swx-probs"></div>
          </div>
        </div>
      </div>

      <div class="share-row">
        <a href="/card/" class="share-link">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <circle cx="11" cy="2.5" r="1.5" stroke="currentColor" stroke-width="1.4"/>
            <circle cx="11" cy="11.5" r="1.5" stroke="currentColor" stroke-width="1.4"/>
            <circle cx="3"  cy="7"   r="1.5" stroke="currentColor" stroke-width="1.4"/>
            <path d="M4.5 6.2 9.5 3.3M4.5 7.8 9.5 10.7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
          Share conditions
        </a>
        <div class="push-wrap" id="push-wrap">
          <button id="push-btn" class="push-btn" type="button" title="Space weather push alerts" aria-label="Enable push notifications">
            <svg width="13" height="14" viewBox="0 0 13 14" fill="none" aria-hidden="true">
              <path d="M6.5 1C4.3 1 2.5 2.8 2.5 5v4L1 10.5h11L10.5 9V5C10.5 2.8 8.7 1 6.5 1z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
              <path d="M5.2 10.8c0 .7.6 1.2 1.3 1.2s1.3-.5 1.3-1.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
            <span id="push-label">Alerts</span>
          </button>
          <div class="push-panel" id="push-panel" hidden>
            <div class="push-prow">
              <label class="push-plabel" for="push-kp">Alert when Kp ≥</label>
              <select id="push-kp" class="push-sel">
                <option value="4">4</option>
                <option value="5" selected>5</option>
                <option value="6">6</option>
                <option value="7">7</option>
              </select>
            </div>
            <button id="push-subscribe" class="push-sub-btn">Enable alerts</button>
            <button id="push-unsubscribe" class="push-unsub-btn" hidden>Disable alerts</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Space weather alerts ribbon -->
  <section id="space-alerts" aria-label="Space weather alerts" aria-live="polite">
    <div class="wrap">
      <div class="alerts-bar" id="alerts-bar">
        <span class="ab-icon" id="ab-icon" aria-hidden="true">✓</span>
        <div class="ab-body">
          <span class="ab-status" id="ab-status">All quiet — no active NOAA space weather alerts</span>
          <ul class="ab-list" id="ab-list" hidden></ul>
        </div>
      </div>
    </div>
  </section>

  <section id="band-conditions" aria-label="HF band conditions">
    <div class="wrap">
      <p class="seclabel">Derived from Live Data</p>
      <h2>HF band conditions</h2>
      <p class="sec-intro" id="band-basis">Loading conditions…</p>

      <div class="bc-time-row">
        <div class="bc-time-head">
          <span class="bc-time-label">Simulated time:</span>
          <span id="bc-time-display" class="bc-time-val">Now</span>
          <button id="bc-reset" class="bc-reset-btn" type="button" hidden>Reset</button>
        </div>
        <input type="range" id="bc-offset" class="bc-slider" min="-12" max="12" step="0.5" value="0" aria-label="Time offset in hours from now">
        <div class="bc-slider-ticks"><span>−12 h</span><span>now</span><span>+12 h</span></div>
      </div>

      <div class="band-grid" id="band-grid"></div>

      <!-- 24h propagation outlook from NOAA Kp forecast -->
      <div class="fc-row" id="fc-row" hidden>
        <span class="fc-label">24 h Kp outlook</span>
        <div class="fc-strip" id="fc-strip" role="list" aria-label="24-hour Kp forecast slots"></div>
      </div>

      <p class="data-updated" style="margin-top:14px">Estimated from SFI and Kp · real conditions vary by path, antenna, and solar terminator</p>
    </div>
  </section>

  <section id="greyline" aria-label="Solar terminator map">
    <div class="wrap">
      <p class="seclabel">Solar Terminator</p>
      <h2>Greyline map</h2>
      <p class="sec-intro">The greyline is the twilight boundary between day and night. The 30-minute window around it — when the ionosphere is in transition — often produces outstanding long-path propagation on 40 m and 80 m.</p>
      <div class="gl-outer">
        <canvas id="gl-canvas" class="gl-canvas" aria-label="Solar terminator world map"></canvas>
        <div class="gl-info">
          <span id="gl-utc" class="gl-stat"></span>
          <span class="gl-sep">·</span>
          <span id="gl-sun" class="gl-stat"></span>
        </div>
      </div>
      <p class="data-updated" style="margin-top:10px">Equirectangular projection · terminator updates every minute · yellow dot = subsolar point · dashed lines = tropics</p>
    </div>
  </section>

  <section id="solar-imagery" aria-label="Live solar images">
    <div class="wrap">
      <p class="seclabel">NASA / ESA Live Imagery</p>
      <h2>The sun right now</h2>
      <p class="sec-intro">Live solar imagery from NASA's Solar Dynamics Observatory and the ESA/NASA SOHO spacecraft — updated every few minutes.</p>
      <div class="imagery-grid">
        <figure class="img-card">
          <div class="img-wrap"><img id="img-aia193" src="" alt="SDO AIA 193 Å coronal plasma" class="solar-img" loading="lazy" /></div>
          <figcaption><strong>SDO AIA 193 Å</strong> · Hot coronal plasma at ~1.5 MK. Bright regions are active areas — flare-prone loops and spots that drive X-ray bursts.</figcaption>
        </figure>
        <figure class="img-card">
          <div class="img-wrap"><img id="img-hmi" src="" alt="SDO HMI white-light sunspot map" class="solar-img" loading="lazy" /></div>
          <figcaption><strong>SDO HMI Continuum</strong> · White-light sunspot map. Dark umbral regions indicate strong magnetic flux — more spots correlate directly with higher SFI.</figcaption>
        </figure>
        <figure class="img-card">
          <div class="img-wrap"><img id="img-lasco" src="" alt="SOHO LASCO C3 coronagraph" class="solar-img" loading="lazy" /></div>
          <figcaption><strong>SOHO LASCO C3</strong> · Coronagraph — white disk occludes the sun. Bright expanding halos are coronal mass ejections (CMEs) that may reach Earth in 1–3 days.</figcaption>
        </figure>
        <figure class="img-card">
          <div class="img-wrap"><img id="img-stereo" src="https://stereo-ssc.nascom.nasa.gov/beacon/latest_256_A_195.jpg" alt="STEREO-A EUVI 195 Å" class="solar-img" loading="lazy" /></div>
          <figcaption><strong>STEREO-A EUVI 195 Å</strong> · NASA STEREO-A spacecraft views the sun from a different orbital vantage point, revealing active regions rotating toward or away from Earth.</figcaption>
        </figure>
      </div>
      <p class="data-updated" style="margin-top:14px">NASA SDO (sdo.gsfc.nasa.gov) · ESA/NASA SOHO (soho.nascom.nasa.gov) · NASA STEREO-SSC · Images delayed ~15–60 min from real-time</p>
    </div>
  </section>

  <section id="active-regions" aria-label="Active solar regions">
    <div class="wrap">
      <p class="seclabel">NOAA SWPC</p>
      <h2>Active solar regions</h2>
      <p class="sec-intro">Currently numbered NOAA Active Regions (AR) on the solar disk, ranked by flare potential. Magnetic classification and C/M/X flare probabilities are updated every 30 minutes.</p>
      <div id="ar-table-wrap" class="ar-table-wrap">
        <p class="data-updated" id="ar-status">Loading active regions…</p>
      </div>
      <p class="data-updated" style="margin-top:10px">Source: NOAA SWPC solar_regions.json · updated every 30 min</p>
    </div>
  </section>

  <section id="flare-log" aria-label="Recent solar flares">
    <div class="wrap">
      <p class="seclabel">GOES X-Ray Monitor</p>
      <h2>Recent solar flares</h2>
      <p class="sec-intro">Solar flares detected by NOAA's GOES satellite in the last 7 days, newest first. Each flare briefly floods the sunlit hemisphere with X-rays — larger classes cause HF radio blackouts.</p>
      <div id="flare-table-wrap" class="flare-table-wrap">
        <p class="data-updated" id="flare-status">Loading flare log…</p>
      </div>
      <p class="data-updated" style="margin-top:10px">Source: NOAA GOES primary xray-flares-7-day · updated every 5 min</p>
    </div>
  </section>

  <section id="history" aria-label="Solar history">
    <div class="wrap">
      <div class="history-top">
        <div>
          <p class="seclabel" id="history-label">24-Hour History</p>
          <h2>Solar trend</h2>
        </div>
        <div class="range-tabs" role="group" aria-label="Time range">
          <button class="range-tab" data-hours="6">6 h</button>
          <button class="range-tab active" data-hours="24">24 h</button>
          <button class="range-tab" data-hours="168">7 d</button>
        </div>
      </div>

      <div class="grid cols2" style="margin-top:24px">
        <div class="chart-card">
          <div class="chart-head">
            <span class="chart-lbl">Solar Flux Index (SFI)</span>
            <span class="chart-cur" id="chart-sfi-cur"></span>
          </div>
          <svg id="chart-sfi" class="chart-svg" viewBox="0 0 560 80" preserveAspectRatio="none">
            <text x="280" y="44" text-anchor="middle" fill="#475569" font-size="11" font-family="monospace">loading…</text>
          </svg>
          <div class="chart-foot">
            <span id="chart-sfi-start"></span>
            <span>now</span>
          </div>
        </div>

        <div class="chart-card">
          <div class="chart-head">
            <span class="chart-lbl">K-Index (Kp)</span>
            <span class="chart-cur" id="chart-kp-cur"></span>
          </div>
          <svg id="chart-kp" class="chart-svg" viewBox="0 0 560 80" preserveAspectRatio="none">
            <text x="280" y="44" text-anchor="middle" fill="#475569" font-size="11" font-family="monospace">loading…</text>
          </svg>
          <div class="chart-foot">
            <span id="chart-kp-start"></span>
            <span>now</span>
          </div>
        </div>
      </div>
      <p class="data-updated" id="history-updated"></p>
    </div>
  </section>

  <section id="trends" aria-label="Solar trend charts">
    <div class="wrap">
      <p class="seclabel">Trend Analysis</p>
      <h2>Historical solar data</h2>
      <p class="sec-intro">Long-term trends in solar flux, geomagnetic activity, and sunspot cycle — updated every 15 minutes from NOAA SWPC.</p>

      <div class="trends-grid">

        <!-- SFI trend -->
        <div class="trend-card" id="tc-sfi">
          <div class="tc-head">
            <span class="tc-lbl">Solar Flux Index (SFI)</span>
            <div class="tc-tabs" role="group" aria-label="SFI range">
              <button class="tc-tab active" data-chart="sfi" data-days="30">30 d</button>
              <button class="tc-tab" data-chart="sfi" data-days="60">60 d</button>
              <button class="tc-tab" data-chart="sfi" data-days="90">90 d</button>
            </div>
          </div>
          <div class="tc-body"><canvas id="canvas-sfi"></canvas></div>
        </div>

        <!-- K-index 7-day bars + forecast -->
        <div class="trend-card" id="tc-kp">
          <div class="tc-head">
            <span class="tc-lbl">Planetary K-Index — 7 days + forecast</span>
          </div>
          <div class="tc-body"><canvas id="canvas-kp"></canvas></div>
        </div>

        <!-- K-index 24h bar chart -->
        <div class="trend-card" id="tc-kp24">
          <div class="tc-head">
            <span class="tc-lbl">Kp — Last 24 hours (3-hour buckets)</span>
          </div>
          <div class="tc-body"><canvas id="canvas-kp24"></canvas></div>
        </div>

        <!-- X-ray flux 6-hour timeline -->
        <div class="trend-card trend-card--wide" id="tc-xray-chart">
          <div class="tc-head">
            <span class="tc-lbl">X-Ray Flux — 6 hours (GOES · log scale)</span>
          </div>
          <div class="tc-body"><canvas id="canvas-xray"></canvas></div>
        </div>

        <!-- 3-day planetary Kp bar chart -->
        <div class="trend-card trend-card--wide" id="tc-kp3day">
          <div class="tc-head">
            <span class="tc-lbl">Planetary Kp — 3-Day History (3-hour bars)</span>
          </div>
          <div class="tc-body tc-kp3day-body">
            <div id="kp3day-chart" class="kp3day-chart" aria-label="3-day Kp bar chart"></div>
          </div>
        </div>

        <!-- A-index daily geomagnetic activity -->
        <div class="trend-card trend-card--wide" id="tc-aindex">
          <div class="tc-head">
            <span class="tc-lbl">A-Index (Ap) — Daily Geomagnetic Activity</span>
            <div class="tc-tabs" role="group" aria-label="A-index range">
              <button class="tc-tab active" data-chart="aindex" data-days="7">7 d</button>
              <button class="tc-tab" data-chart="aindex" data-days="30">30 d</button>
              <button class="tc-tab" data-chart="aindex" data-days="90">90 d</button>
            </div>
          </div>
          <div class="tc-body"><canvas id="canvas-aindex"></canvas></div>
        </div>

        <!-- Sunspot trend -->
        <div class="trend-card trend-card--wide" id="tc-ssn">
          <div class="tc-head">
            <span class="tc-lbl">Sunspot Number (SSN)</span>
            <div class="tc-tabs" role="group" aria-label="SSN range">
              <button class="tc-tab active" data-chart="ssn" data-days="30">30 d</button>
              <button class="tc-tab" data-chart="ssn" data-days="60">60 d</button>
              <button class="tc-tab" data-chart="ssn" data-days="90">90 d</button>
            </div>
          </div>
          <div class="tc-body"><canvas id="canvas-ssn"></canvas></div>
        </div>

        <!-- Solar Cycle 25 position -->
        <div class="trend-card trend-card--wide" id="tc-solarcycle">
          <div class="tc-head">
            <span class="tc-lbl">Solar Cycle 25 — Observed SSN vs NOAA Predicted</span>
            <span class="chart-cur" id="sc-cur-ssn"></span>
          </div>
          <div class="tc-body"><canvas id="canvas-solarcycle"></canvas></div>
        </div>

      </div>
    </div>
  </section>

  <section id="what-it-means" aria-label="Impact on radio">
    <div class="wrap">
      <p class="seclabel">Ham Radio Impact</p>
      <h2>What the numbers mean for your radio</h2>
      <p class="sec-intro" id="conditions-summary">Loading current conditions…</p>
      <div class="grid cols3" style="margin-top:32px">
        <div class="card">
          <div class="ico">📻</div>
          <h3>HF Propagation</h3>
          <p id="card-hf">Loading…</p>
        </div>
        <div class="card">
          <div class="ico">🌍</div>
          <h3>Geomagnetic Activity</h3>
          <p id="card-geo">Loading…</p>
        </div>
        <div class="card">
          <div class="ico">☀️</div>
          <h3>Solar Events</h3>
          <p id="card-solar">Loading…</p>
        </div>
      </div>
    </div>
  </section>

  <section id="contest-calendar" aria-label="Ham radio contest calendar">
    <div class="wrap">
      <p class="seclabel">Ham Radio</p>
      <h2>Upcoming major HF contests</h2>
      <p class="sec-intro">Major HF operating events — knowing the calendar helps you plan propagation windows and choose the right bands to maximize contacts.</p>
      <div class="contest-list" id="contest-list"></div>
    </div>
  </section>

  <section id="learn-teaser" aria-label="Learn more">
    <div class="wrap">
      <p class="seclabel">Education</p>
      <h2>Why does any of this matter?</h2>
      <p class="sec-intro">Solar activity directly shapes the ionosphere — and the ionosphere controls which amateur radio bands are open and how far your contacts can reach. Once you understand the connection, you'll know exactly when to call CQ.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/learn/">Learn about propagation →</a>
        <a class="btn btn-ghost" href="https://tavaoneeducation.org/" target="_blank" rel="noopener">TavaOne Education ↗</a>
      </div>
    </div>
  </section>
</Shell>

<style>
  /* ── Storm alert banner ── */
  .storm-banner {
    background: rgba(245,158,11,.10);
    border-bottom: 1px solid rgba(245,158,11,.30);
    padding: 9px 0;
  }
  .storm-banner.sb-severe {
    background: rgba(239,68,68,.10);
    border-bottom-color: rgba(239,68,68,.30);
  }
  .sb-inner {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .sb-icon { font-size: .95rem; flex-shrink: 0; }
  .sb-text {
    flex: 1;
    font-size: .8rem;
    font-family: var(--mono);
    color: #fbbf24;
    letter-spacing: .04em;
    line-height: 1.45;
  }
  .storm-banner.sb-severe .sb-text { color: #f87171; }
  .sb-close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
    color: var(--muted);
    opacity: .65;
    flex-shrink: 0;
    line-height: 0;
    border-radius: 4px;
  }
  .sb-close:hover { opacity: 1; background: rgba(255,255,255,.05); }

  .data-updated {
    margin-top: 12px;
    font-family: var(--mono);
    font-size: .74rem;
    color: var(--muted);
    opacity: .6;
    letter-spacing: .06em;
  }

  /* ── NOAA storm scales (WWV) ── */
  .wwv-row {
    margin-top: 18px;
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
  }
  .wwv-label {
    font-family: var(--mono); font-size: .7rem; letter-spacing: .1em;
    text-transform: uppercase; color: var(--muted); flex-shrink: 0;
  }
  .wwv-badges { display: flex; gap: 8px; flex-wrap: wrap; }
  .wwv-badge {
    display: flex; flex-direction: column; align-items: center;
    background: var(--card); border: 1px solid var(--border);
    border-radius: 9px; padding: 8px 16px; min-width: 76px;
    transition: border-color .18s, background .18s;
  }
  .wwv-badge.scale-active { border-color: rgba(245,158,11,.5); background: rgba(245,158,11,.06); }
  .wwv-badge.scale-severe { border-color: rgba(220,38,38,.5);  background: rgba(220,38,38,.06); }
  .wb-val {
    font-family: var(--mono); font-size: 1.1rem; font-weight: 700; color: var(--text); line-height: 1;
  }
  .wwv-badge.scale-active .wb-val { color: #fbbf24; }
  .wwv-badge.scale-severe .wb-val { color: #f87171; }
  .wb-lbl { font-family: var(--mono); font-size: .58rem; color: var(--muted); margin-top: 4px; letter-spacing: .04em; }
  .wwv-explain {
    font-family: var(--mono); font-size: .68rem; color: var(--muted);
    text-decoration: none; margin-left: auto;
  }
  .wwv-explain:hover { color: var(--green-lt); }

  /* ── Solar wind row ── */
  .sw-row {
    margin-top: 14px;
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
  }
  .sw-badges { display: flex; gap: 8px; flex-wrap: wrap; }
  .sw-badge {
    display: flex; flex-direction: column; align-items: center;
    background: var(--card); border: 1px solid var(--border);
    border-radius: 9px; padding: 6px 14px; min-width: 68px;
    transition: border-color .18s, background .18s;
  }
  .sw-badge.sw-south { border-color: rgba(239,68,68,.4); background: rgba(239,68,68,.05); }
  .sw-badge.sw-north { border-color: rgba(16,185,129,.35); background: rgba(16,185,129,.05); }
  .sw-val {
    font-family: var(--mono); font-size: .98rem; font-weight: 700; color: var(--text); line-height: 1;
  }
  .sw-badge.sw-south .sw-val { color: #f87171; }
  .sw-badge.sw-north .sw-val { color: #10b981; }
  .sw-sub { font-family: var(--mono); font-size: .58rem; color: var(--muted); margin-top: 3px; letter-spacing: .04em; white-space: nowrap; }
  .sw-mini-chart { border-radius: 4px; background: rgba(0,0,0,.2); flex-shrink: 0; }
  .sw-updated { font-family: var(--mono); font-size: .65rem; color: var(--muted); }

  /* ── Radio blackout row ── */
  .rb-row {
    margin-top: 10px;
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
  }
  .rb-badge {
    display: flex; align-items: center; gap: 8px;
    background: var(--card); border: 1px solid var(--border);
    border-radius: 9px; padding: 5px 14px;
    transition: border-color .18s, background .18s;
  }
  .rb-badge.rb-minor   { border-color: rgba(251,191,36,.4);  background: rgba(251,191,36,.05); }
  .rb-badge.rb-moderate{ border-color: rgba(251,146,60,.4);  background: rgba(251,146,60,.05); }
  .rb-badge.rb-strong  { border-color: rgba(239,68,68,.4);   background: rgba(239,68,68,.06); }
  .rb-scale { font-family: var(--mono); font-size: .98rem; font-weight: 700; color: var(--muted); line-height: 1; }
  .rb-badge.rb-minor    .rb-scale { color: #fbbf24; }
  .rb-badge.rb-moderate .rb-scale { color: #fb923c; }
  .rb-badge.rb-strong   .rb-scale { color: #f87171; }
  .rb-desc  { font-family: var(--mono); font-size: .7rem; color: var(--muted); }
  .rb-freqs { font-family: var(--mono); font-size: .68rem; color: var(--muted); }

  /* ── Push notification button ── */
  .push-wrap { position: relative; }
  .push-btn {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-family: var(--mono); font-size: .75rem; letter-spacing: .06em;
    color: var(--muted); padding: 6px 12px;
    border: 1px solid var(--border); border-radius: 7px;
    background: none; cursor: pointer;
    transition: color .18s, border-color .18s;
  }
  .push-btn:hover { color: var(--green-lt); border-color: var(--green-dk); }
  .push-btn.push-active { color: var(--green-lt); border-color: var(--green-dk); }
  .push-panel {
    position: absolute; bottom: calc(100% + 6px); left: 0;
    background: var(--card); border: 1px solid var(--border);
    border-radius: 10px; padding: 12px 14px; min-width: 190px; z-index: 20;
    display: flex; flex-direction: column; gap: 9px;
    box-shadow: 0 4px 20px rgba(0,0,0,.3);
  }
  .push-prow { display: flex; align-items: center; gap: 8px; }
  .push-plabel { font-family: var(--mono); font-size: .72rem; color: var(--muted); flex: 1; }
  .push-sel {
    font-family: var(--mono); font-size: .75rem; background: var(--bg);
    border: 1px solid var(--border); color: var(--text); border-radius: 5px;
    padding: 3px 6px; cursor: pointer;
  }
  .push-sub-btn, .push-unsub-btn {
    font-family: var(--mono); font-size: .72rem; letter-spacing: .04em;
    padding: 6px 10px; border-radius: 6px; cursor: pointer; border: none;
    transition: background .15s;
  }
  .push-sub-btn { background: var(--green-dk); color: var(--green-lt); }
  .push-sub-btn:hover { background: #10b981; color: #fff; }
  .push-unsub-btn { background: rgba(248,113,113,.12); color: #f87171; border: 1px solid rgba(248,113,113,.2); }
  .push-unsub-btn:hover { background: rgba(248,113,113,.22); }

  .share-row {
    margin-top: 16px;
    display: flex;
  }
  .share-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--mono);
    font-size: .75rem;
    letter-spacing: .06em;
    color: var(--muted);
    text-decoration: none;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 7px;
    transition: color .18s, border-color .18s;
  }
  .share-link:hover {
    color: var(--green-lt);
    border-color: var(--green-dk);
  }

  /* History section */
  .history-top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }
  .range-tabs {
    display: flex;
    gap: 3px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 3px;
    flex-shrink: 0;
  }
  .range-tab {
    background: none;
    border: none;
    padding: 5px 13px;
    border-radius: 5px;
    font-family: var(--mono);
    font-size: .75rem;
    letter-spacing: .06em;
    color: var(--muted);
    cursor: pointer;
    transition: background .12s, color .12s;
  }
  .range-tab:hover { color: var(--text); }
  .range-tab.active { background: var(--green-dk); color: var(--green-lt); }

  /* Chart cards */
  .chart-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px 22px 14px;
    transition: border-color .18s;
  }
  .chart-card:hover { border-color: var(--green-dk); }
  .chart-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .chart-lbl {
    font-family: var(--mono);
    font-size: .72rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .chart-cur {
    font-family: var(--mono);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--green-lt);
  }
  .chart-svg {
    display: block;
    width: 100%;
    height: 88px;
  }
  .chart-foot {
    display: flex;
    justify-content: space-between;
    margin-top: 7px;
    font-family: var(--mono);
    font-size: .68rem;
    color: var(--muted);
    opacity: .5;
  }

  /* ── Trend charts section ── */
  #trends { padding-top: 0; }
  .trends-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: 32px;
  }
  .trend-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px 22px 16px;
    transition: border-color .18s;
    min-width: 0;
  }
  .trend-card:hover { border-color: var(--green-dk); }
  .trend-card--wide { grid-column: 1 / -1; }
  .tc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 14px;
  }
  .tc-lbl {
    font-family: var(--mono);
    font-size: .72rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tc-tabs {
    display: flex;
    gap: 2px;
    background: rgba(255,255,255,.04);
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 2px;
  }
  .tc-tab {
    background: none;
    border: none;
    padding: 4px 11px;
    border-radius: 5px;
    font-family: var(--mono);
    font-size: .7rem;
    letter-spacing: .06em;
    color: var(--muted);
    cursor: pointer;
    transition: background .12s, color .12s;
  }
  .tc-tab:hover { color: var(--text); }
  .tc-tab.active { background: var(--green-dk); color: var(--green-lt); }
  .tc-body { position: relative; }
  .tc-body canvas { display: block; width: 100% !important; height: 140px !important; }

  @media (max-width: 820px) {
    .trends-grid { grid-template-columns: 1fr; }
    .trend-card--wide { grid-column: auto; }
  }

  /* ── Space weather alerts bar ── */
  #space-alerts { padding: 0 0 8px; }
  .alerts-bar {
    display: flex; align-items: flex-start; gap: 12px;
    padding: 12px 18px; border-radius: 12px;
    border: 1px solid var(--border); background: var(--card);
    transition: border-color .2s, background .2s;
  }
  .alerts-bar.has-alerts {
    border-color: rgba(245,158,11,.45);
    background: rgba(245,158,11,.04);
  }
  .ab-icon { font-family: var(--mono); font-size: .88rem; color: var(--green-lt); flex-shrink: 0; margin-top: 2px; }
  .alerts-bar.has-alerts .ab-icon { color: #f59e0b; }
  .ab-body { flex: 1; min-width: 0; }
  .ab-status { font-family: var(--mono); font-size: .76rem; color: var(--muted); }
  .ab-list {
    list-style: none; margin: 8px 0 0; padding: 0;
    display: flex; flex-direction: column; gap: 6px;
  }
  .ab-item { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .ab-pid {
    font-family: var(--mono); font-size: .66rem; letter-spacing: .06em;
    color: #f59e0b; background: rgba(245,158,11,.12);
    padding: 1px 6px; border-radius: 4px; flex-shrink: 0;
  }
  .ab-time { font-family: var(--mono); font-size: .68rem; color: var(--muted); flex-shrink: 0; }
  .ab-line { font-family: var(--mono); font-size: .74rem; color: var(--text); }

  /* ── 24-hour forecast strip ── */
  .fc-row {
    display: flex; align-items: flex-end; gap: 14px;
    margin-top: 18px; flex-wrap: wrap;
  }
  .fc-label {
    font-family: var(--mono); font-size: .7rem; letter-spacing: .1em;
    text-transform: uppercase; color: var(--muted); flex-shrink: 0; padding-bottom: 20px;
  }
  .fc-strip {
    display: flex; gap: 6px; flex: 1; align-items: flex-end;
  }
  .fc-slot {
    display: flex; flex-direction: column; align-items: center;
    gap: 2px; min-width: 38px; flex: 1;
  }
  .fc-bars-area {
    width: 100%; height: 44px; display: flex; align-items: flex-end;
  }
  .fc-bar {
    width: 100%; border-radius: 3px 3px 0 0; min-height: 3px;
  }
  .fc-kp {
    font-family: var(--mono); font-size: .68rem; font-weight: 700; line-height: 1;
  }
  .fc-time {
    font-family: var(--mono); font-size: .6rem; color: var(--muted); white-space: nowrap;
  }

  /* ── Trend chart empty state ── */
  .tc-empty {
    height: 140px;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 4px; font-family: var(--mono); font-size: .72rem; letter-spacing: .04em;
    color: var(--muted); opacity: .5; text-align: center;
  }

  /* ── Band conditions time slider ── */
  .bc-time-row {
    margin: 16px 0 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .bc-time-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: .75rem;
  }
  .bc-time-label { color: var(--muted); }
  .bc-time-val   { color: var(--green-lt); font-weight: 600; }
  .bc-reset-btn {
    margin-left: auto;
    background: none;
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 2px 8px;
    font-family: var(--mono);
    font-size: .68rem;
    color: var(--muted);
    cursor: pointer;
  }
  .bc-reset-btn:hover { border-color: var(--green-dk); color: var(--green-lt); }
  .bc-slider { width: 100%; accent-color: #10b981; cursor: pointer; }
  .bc-slider-ticks {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: .65rem;
    color: var(--muted);
    opacity: .55;
  }

  /* ── Greyline map ── */
  #greyline { padding-top: 0; }
  .gl-outer {
    margin-top: 24px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .gl-canvas { display: block; width: 100%; height: auto; image-rendering: pixelated; }
  .gl-info {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: rgba(0,0,0,.4);
    font-family: var(--mono);
    font-size: .72rem;
  }
  .gl-stat { color: var(--green-lt); }
  .gl-sep  { color: var(--muted); opacity: .45; }

  /* ── Solar imagery ── */
  #solar-imagery { padding-top: 0; }
  .imagery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-top: 28px;
  }
  @media (max-width: 900px) { .imagery-grid { grid-template-columns: repeat(2, 1fr); } }
  .img-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    margin: 0;
    transition: border-color .18s;
  }
  .img-card:hover { border-color: var(--green-dk); }
  .img-wrap {
    aspect-ratio: 1;
    background: #060e1a;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .solar-img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .img-card figcaption {
    padding: 10px 12px 12px;
    font-size: .73rem;
    color: var(--muted);
    line-height: 1.5;
  }
  @media (max-width: 640px) {
    .imagery-grid { grid-template-columns: 1fr; }
    .tc-body canvas { height: 110px !important; }
    .tc-empty { height: 110px; }
    .fc-slot { min-width: 28px; }
    .fc-time { font-size: .55rem; }
    .fc-bars-area { height: 36px; }
  }
  @media (max-width: 420px) {
    .fc-strip { gap: 3px; }
    .ab-list { gap: 8px; }
  }

  /* ── Space weather cluster (layout-only wrapper, no background) ── */
  .swx-cluster { margin-top: 10px; }
  .swx-cluster:not(:has(> :not([hidden]))) { display: none; }

  /* ── Aurora row ── */
  .aurora-row {
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    margin-top: 10px;
  }
  .aurora-badge {
    display: flex; align-items: center; gap: 10px;
    background: var(--card); border: 1px solid var(--border);
    border-radius: 9px; padding: 7px 14px;
    transition: border-color .2s, background .2s;
  }
  .aurora-badge.aurora-active {
    border-color: rgba(139,92,246,.55);
    background: rgba(139,92,246,.08);
  }
  .aurora-icon { font-size: 1.1rem; line-height: 1; flex-shrink: 0; }
  .aurora-vals { display: flex; flex-direction: column; gap: 2px; }
  .aurora-bound {
    font-family: var(--mono); font-size: 1rem; font-weight: 700;
    color: var(--muted); line-height: 1;
  }
  .aurora-badge.aurora-active .aurora-bound { color: #c4b5fd; }
  .aurora-region { font-family: var(--mono); font-size: .68rem; color: var(--muted); line-height: 1.3; }
  .aurora-badge.aurora-active .aurora-region { color: #a78bfa; }

  /* ── 3-Day space weather outlook row ── */
  /* .swx-row / .swx-inner / .swx-days / .swx-probs are static template elements — scoped CSS fine */
  .swx-row   { display: flex; align-items: flex-start; gap: 14px; flex-wrap: wrap; margin-top: 10px; }
  .swx-inner { display: flex; flex-direction: column; gap: 12px; flex: 1; }
  .swx-days  { display: flex; gap: 8px; flex-wrap: wrap; }
  .swx-probs { display: flex; flex-direction: column; gap: 6px; font-family: var(--mono); font-size: .7rem; color: var(--muted); }

  /* Everything below is injected via innerHTML — must use :global() so Astro's scoped
     data-attribute selector doesn't strip the rules from dynamically-created elements. */
  :global(.swx-day) {
    display: flex; flex-direction: column; align-items: flex-start;
    background: var(--card); border: 1px solid var(--border);
    border-radius: 10px; padding: 10px 14px; min-width: 110px; gap: 6px;
    transition: border-color .2s, background .2s;
  }
  :global(.swx-day.swx-active) { border-color: rgba(245,158,11,.6); background: rgba(245,158,11,.08); }
  :global(.swx-day.swx-severe) { border-color: rgba(239,68,68,.6);  background: rgba(239,68,68,.08); }
  :global(.swx-day-label) {
    font-family: var(--mono); font-size: .6rem; letter-spacing: .1em;
    color: var(--muted); text-transform: uppercase;
  }
  :global(.swx-kp) { font-family: var(--mono); font-size: 1.15rem; font-weight: 700; line-height: 1; }
  :global(.swx-pills) { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 2px; }
  :global(.swx-pill) {
    font-family: var(--mono); font-size: .6rem; padding: 2px 6px;
    border-radius: 4px; letter-spacing: .03em;
  }
  :global(.swx-pill b)   { font-weight: 700; }
  :global(.swx-pill-r)   { background: rgba(251,191,36,.12); color: #fbbf24; border: 1px solid rgba(251,191,36,.25); }
  :global(.swx-pill-rx)  { background: rgba(248,113,113,.12); color: #f87171; border: 1px solid rgba(248,113,113,.25); }
  :global(.swx-pill-g)   { background: rgba(167,139,250,.12); color: #a78bfa; border: 1px solid rgba(167,139,250,.25); }
  :global(.swx-quiet)    { font-family: var(--mono); font-size: .62rem; color: var(--muted); opacity: .6; }
  :global(.swx-probs-title) {
    font-size: .6rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--muted); opacity: .55; margin-bottom: 2px;
  }
  :global(.swx-prob-row) { display: flex; align-items: center; gap: 8px; }
  :global(.swx-prob-lbl) { min-width: 52px; letter-spacing: .01em; font-family: var(--mono); }
  :global(.swx-prob-bar) { flex: 1; height: 8px; background: rgba(255,255,255,.08); border-radius: 4px; overflow: hidden; }
  :global(.swx-prob-fill) { height: 100%; border-radius: 4px; min-width: 3px; transition: width .35s ease; }
  :global(.swx-prob-val) { min-width: 34px; text-align: right; font-weight: 600; letter-spacing: .01em; font-family: var(--mono); }

  /* ── Active Solar Regions table ── */
  #active-regions { padding-top: 0; }
  .ar-table-wrap { margin-top: 20px; overflow-x: auto; }
  .ar-table {
    width: 100%; border-collapse: collapse;
    font-family: var(--mono); font-size: .75rem;
  }
  .ar-table th {
    text-align: left; padding: 7px 12px;
    border-bottom: 1px solid var(--border);
