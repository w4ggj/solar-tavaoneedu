  .kp3day-bar-wrap { display: flex; flex-direction: column; align-items: center; gap: 2px; flex: 1; min-width: 18px; }
  .kp3day-bar {
    width: 100%; border-radius: 2px 2px 0 0;
    transition: opacity .15s;
  }
  .kp3day-bar-wrap:hover .kp3day-bar { opacity: .75; }
  .kp3day-label { font-family: var(--mono); font-size: .48rem; color: var(--muted); white-space: nowrap; }

  /* ── Ham Contest Calendar ── */
  #contest-calendar { padding-top: 0; }
  .contest-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
