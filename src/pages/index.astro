  }
  .flare-table tr:last-child td { border-bottom: none; }
  .flare-table tr:hover td { background: rgba(255,255,255,.02); }
  .flare-cls-a, .flare-cls-b { color: var(--muted); }
  .flare-cls-c { color: #6ee7b7; }
  .flare-cls-m { color: #fbbf24; font-weight: 700; }
