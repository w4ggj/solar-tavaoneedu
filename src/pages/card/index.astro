---
import Shell from '../../layouts/Shell.astro';
---
<Shell
  title="Share Solar Conditions — TavaOne Solar"
  description="Download a branded solar conditions card for social media, or copy auto-generated post text."
>

<style>
    :root {
      --surf:   #0f172a;
      --surf2:  #1a2540;
      --em:     #10b981;
      --em-lt:  #34d399;
      --em-dk:  #065f46;
      --warn:   #f59e0b;
      --danger: #ef4444;
    }

    .card-page-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 2rem 1rem 4rem;
    }

    /* ── Two-column layout ── */
    .main-wrap {
      width: 100%;
      max-width: 860px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      align-items: start;
    }
    @media (max-width: 640px) {
      .main-wrap { grid-template-columns: 1fr; }
    }

    /* ── Card preview (left column) ── */
    .card {
      background: var(--surf);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 1.5rem 1.5rem 1.25rem;
      position: relative;
      overflow: hidden;
    }
    .card::before {
      content: '';
      position: absolute;
      inset: 0 0 auto 0;
      height: 3px;
      background: linear-gradient(90deg, var(--em) 0%, #3b82f6 50%, var(--em) 100%);
      background-size: 200% 100%;
      animation: shimmer 4s linear infinite;
    }
    @keyframes shimmer { to { background-position: 200% 0%; } }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.25rem;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: .45rem;
      font-family: var(--mono);
      font-size: .95rem;
      font-weight: 700;
    }
    .brand img { border-radius: 4px; }
    .brand .sl  { color: var(--em); }
    .brand .sw  { color: var(--em); }
    .card-time {
      display: flex;
      align-items: center;
      gap: .35rem;
      font-size: .72rem;
      color: var(--muted);
      font-family: var(--mono);
    }
    .live-dot { color: var(--em); font-size: .5rem; animation: blink 2s ease-in-out infinite; }
    @keyframes blink { 0%,100% { opacity:1 } 50% { opacity:.2 } }

    .card-tiles {
      display: grid;
      grid-template-columns: repeat(4,1fr);
      gap: .6rem;
      margin-bottom: .9rem;
    }
    .card-tile {
      background: var(--surf2);
      border-radius: 10px;
      padding: .75rem .5rem;
      text-align: center;
    }
    .ct-label { font-size: .6rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); margin-bottom: .35rem; }
    .ct-value { font-family: var(--mono); font-size: 1.55rem; font-weight: 700; line-height: 1; margin-bottom: .2rem; }
    .ct-sub   { font-size: .58rem; color: var(--muted); }

    .card-condition {
      background: var(--surf2);
      border-radius: 10px;
      padding: .8rem 1rem;
      margin-bottom: .9rem;
    }
    .cond-label { font-family: var(--mono); font-weight: 700; font-size: .9rem; display: block; margin-bottom: .3rem; }
    .cond-bands { font-size: .75rem; color: var(--muted); }

    .card-alerts {
      font-size: .7rem;
      color: var(--warn);
      font-family: var(--mono);
      padding: .5rem .875rem;
      background: rgba(245,158,11,.08);
      border: 1px solid rgba(245,158,11,.2);
      border-radius: 7px;
      margin-bottom: .875rem;
      display: none;
    }
    .card-alerts.visible { display: block; }

    .card-footer {
      display: flex;
      justify-content: space-between;
      font-size: .65rem;
      color: var(--muted);
      font-family: var(--mono);
      border-top: 1px solid var(--border);
      padding-top: .875rem;
    }

    /* ── Social panel (right column) ── */
    .social-panel { display: flex; flex-direction: column; gap: 12px; }

    .sp-card {
      background: var(--surf);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px 16px;
    }
    .sp-title {
      font-family: var(--mono);
      font-size: .68rem;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 8px;
    }

    /* Segment controls */
    .seg-group {
      display: flex;
      gap: 3px;
      background: rgba(255,255,255,.04);
      border: 1px solid var(--border);
      border-radius: 7px;
      padding: 2px;
    }
    .seg-btn {
      flex: 1;
      background: none;
      border: none;
      padding: 5px 8px;
      border-radius: 5px;
      font-family: var(--mono);
      font-size: .68rem;
      letter-spacing: .04em;
      color: var(--muted);
      cursor: pointer;
      transition: background .12s, color .12s;
      white-space: nowrap;
    }
    .seg-btn:hover { color: var(--text); }
    .seg-btn.active { background: var(--em-dk); color: var(--em-lt); }

    /* Download button */
    .dl-btn {
      width: 100%;
      padding: 11px;
      background: var(--em);
      color: #04221a;
      border: none;
      border-radius: 10px;
      font-family: var(--sans);
      font-size: .9rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .4rem;
      transition: background .15s, transform .12s;
    }
    .dl-btn:hover:not(:disabled) { background: var(--em-lt); transform: translateY(-1px); }
    .dl-btn:disabled { opacity: .45; cursor: not-allowed; }

    /* Copy blocks */
    .copy-block { position: relative; }
    .copy-field {
      display: block;
      width: 100%;
      background: var(--surf2);
      border: 1px solid var(--border);
      border-radius: 7px;
      padding: 8px 42px 8px 10px;
      font-family: var(--mono);
      font-size: .72rem;
      color: var(--text);
      line-height: 1.5;
      white-space: pre-wrap;
      word-break: break-word;
      min-height: 52px;
    }
    .copy-btn {
      position: absolute;
      top: 7px;
      right: 7px;
      background: var(--bord2);
      border: none;
      border-radius: 4px;
      padding: 3px 7px;
      font-family: var(--mono);
      font-size: .62rem;
      color: var(--muted);
      cursor: pointer;
      transition: background .12s, color .12s;
    }
    .copy-btn:hover, .copy-btn.copied { background: var(--em-dk); color: var(--em-lt); }

    /* Hashtag set buttons */
    .htag-group {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4px;
      margin-bottom: 8px;
    }
    .htag-btn {
      background: none;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 6px 8px;
      font-family: var(--mono);
      font-size: .63rem;
      letter-spacing: .03em;
      color: var(--muted);
      cursor: pointer;
      text-align: left;
      transition: border-color .12s, color .12s, background .12s;
    }
    .htag-btn:hover { border-color: var(--bord2); color: var(--text); }
    .htag-btn.active { border-color: var(--em-dk); background: rgba(16,185,129,.07); color: var(--em-lt); }

    /* Skeleton */
    .skeleton { animation: sk 1.4s ease-in-out infinite; }
    @keyframes sk { 0%,100% { opacity:1 } 50% { opacity:.3 } }

    /* ── Off-screen export card ── */
    #export-card {
      display: none;
      position: fixed;
      left: -9999px;
      top: 0;
      flex-direction: column;
      background: #070b14;
      overflow: hidden;
      font-family: 'JetBrains Mono', ui-monospace, monospace;
    }
    .ec-bar { height: 4px; background: linear-gradient(90deg,#10b981,#3b82f6,#10b981); flex-shrink: 0; }
    .ec-body { flex: 1; display: flex; flex-direction: column; padding: 28px 24px 22px; gap: 16px; }
    .ec-head { display: flex; justify-content: space-between; align-items: flex-start; }
    .ec-brand { font-size: 14px; font-weight: 700; color: #f1f5f9; letter-spacing: -.01em; }
    .ec-brand .sl { color: #10b981; }
    .ec-brand .sw { color: #10b981; }
    .ec-date  { font-size: 9px; color: #64748b; text-align: right; line-height: 1.4; }
    .ec-tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .ec-tile  { background: #1a2540; border-radius: 10px; padding: 14px 10px; text-align: center; }
    .ec-t-lbl { font-size: 8px; text-transform: uppercase; letter-spacing: .08em; color: #64748b; margin-bottom: 8px; }
    .ec-t-val { font-size: 30px; font-weight: 700; line-height: 1; margin-bottom: 4px; }
    .ec-t-sub { font-size: 7px; color: #64748b; }
    .ec-cond  { background: #1a2540; border-radius: 10px; padding: 14px 16px; }
    .ec-c-lbl { font-size: 18px; font-weight: 700; margin-bottom: 6px; }
    .ec-c-bnd { font-size: 10px; color: #94a3b8; line-height: 1.5; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
    .ec-foot  { margin-top: auto; display: flex; justify-content: space-between; align-items: flex-end; padding-top: 12px; border-top: 1px solid #1e293b; }
    .ec-f-site { font-size: 9px; color: #10b981; }
    .ec-f-hndl { font-size: 9px; color: #64748b; text-align: right; }
  </style>

<div class="card-page-wrap">
<div class="main-wrap">

  <!-- LEFT: card preview -->
  <div class="card" id="share-card">
    <div class="card-header">
      <div class="brand">
        <img src="/tavaone-emblem.png" alt="" width="22" height="22" />
        <span>Tava<strong>One</strong><span class="sl">//</span><span class="sw">Solar</span></span>
      </div>
      <div class="card-time">
        <span class="live-dot">●</span>
        <span id="card-updated" class="skeleton">loading…</span>
      </div>
    </div>

    <div class="card-tiles">
      <div class="card-tile">
        <div class="ct-label">Solar Flux</div>
        <div class="ct-value skeleton" id="c-sfi">—</div>
        <div class="ct-sub">SFI (10.7 cm)</div>
      </div>
      <div class="card-tile">
        <div class="ct-label">K-Index</div>
        <div class="ct-value skeleton" id="c-kp">—</div>
        <div class="ct-sub">Planetary Kp</div>
      </div>
      <div class="card-tile">
        <div class="ct-label">A-Index</div>
        <div class="ct-value skeleton" id="c-ai">—</div>
        <div class="ct-sub">Ap (3-hour)</div>
      </div>
      <div class="card-tile">
        <div class="ct-label">X-Ray</div>
        <div class="ct-value skeleton" id="c-xray">—</div>
        <div class="ct-sub">GOES satellite</div>
      </div>
    </div>

    <div class="card-condition">
      <span class="cond-label skeleton" id="cond-label">—</span>
      <span class="cond-bands" id="cond-bands">Loading propagation conditions…</span>
    </div>

    <div class="card-alerts" id="card-alerts"></div>

    <div class="card-footer">
      <span>solar.tavaoneeducation.org</span>
      <span id="card-footer-credit">TavaOne Education · NOAA SWPC</span>
    </div>
  </div>

  <!-- RIGHT: social post builder -->
  <div class="social-panel">

    <div class="sp-card">
      <div class="sp-title">Card format</div>
      <div class="seg-group" id="fmt-group" role="group" aria-label="Card format">
        <button class="seg-btn active" data-fmt="tiktok">TikTok 9:16</button>
        <button class="seg-btn" data-fmt="square">Square 1:1</button>
      </div>
    </div>

    <button class="dl-btn" id="dl-btn" disabled>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M7 1v8M4 7l3 3 3-3M1 10v2a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Download PNG
    </button>

    <div class="sp-card">
      <div class="sp-title">Overlay text</div>
      <div class="copy-block">
        <div class="copy-field" id="overlay-text">Loading…</div>
        <button class="copy-btn" data-target="overlay-text">COPY</button>
      </div>
    </div>

    <div class="sp-card">
      <div class="sp-title">Caption</div>
      <div class="copy-block">
        <div class="copy-field" id="caption-text">Loading…</div>
        <button class="copy-btn" data-target="caption-text">COPY</button>
      </div>
    </div>

    <div class="sp-card">
      <div class="sp-title">Hashtags</div>
      <div class="htag-group" id="htag-group">
        <button class="htag-btn active" data-set="edu">📚 Educational</button>
        <button class="htag-btn" data-set="pota">🏕 POTA</button>
        <button class="htag-btn" data-set="gear">🎙 Gear</button>
        <button class="htag-btn" data-set="fl">🌴 Florida</button>
      </div>
      <div class="copy-block">
        <div class="copy-field" id="htag-text">#hamradio #amateurradio #hamtok #learnontiktok #parksOnTheAir</div>
        <button class="copy-btn" data-target="htag-text">COPY</button>
      </div>
    </div>

    <div class="sp-card">
      <div class="sp-title">Suggested title</div>
      <div class="copy-block">
        <div class="copy-field" id="title-text">Loading…</div>
        <button class="copy-btn" data-target="title-text">COPY</button>
      </div>
    </div>

  </div>
</div>

<!-- Off-screen export card (sized & shown only during html2canvas capture) -->
<div id="export-card">
  <div class="ec-bar"></div>
  <div class="ec-body">
    <div class="ec-head">
      <div class="ec-brand">Tava<strong>One</strong><span class="sl">//</span><span class="sw">Solar</span></div>
      <div class="ec-date" id="ec-date"></div>
    </div>
    <div class="ec-tiles">
      <div class="ec-tile">
        <div class="ec-t-lbl">Solar Flux</div>
        <div class="ec-t-val" id="ec-sfi" style="color:#10b981">—</div>
        <div class="ec-t-sub">SFI (10.7 cm)</div>
      </div>
      <div class="ec-tile">
        <div class="ec-t-lbl">K-Index</div>
        <div class="ec-t-val" id="ec-kp" style="color:#10b981">—</div>
        <div class="ec-t-sub">Planetary Kp</div>
      </div>
      <div class="ec-tile">
        <div class="ec-t-lbl">A-Index</div>
        <div class="ec-t-val" id="ec-ai" style="color:#10b981">—</div>
        <div class="ec-t-sub">Ap (3-hour)</div>
      </div>
      <div class="ec-tile">
        <div class="ec-t-lbl">X-Ray Class</div>
        <div class="ec-t-val" id="ec-xray" style="color:#10b981">—</div>
        <div class="ec-t-sub">GOES satellite</div>
      </div>
    </div>
    <div class="ec-cond">
      <div class="ec-c-lbl" id="ec-cond-label" style="color:#10b981">—</div>
      <div class="ec-c-bnd" id="ec-cond-bands"></div>
    </div>
    <div class="ec-foot">
      <div class="ec-f-site">solar.tavaoneeducation.org</div>
      <div class="ec-f-hndl" id="ec-credit">TavaOne Education<br>NOAA SWPC</div>
    </div>
  </div>
</div>

<script>
  import html2canvas from 'html2canvas';

  // ── Hashtag sets (max 5, no #POTA, always #parksOnTheAir) ──
  const HTAG: Record<string, string> = {
    edu:  '#hamradio #amateurradio #hamtok #learnontiktok #parksOnTheAir',
    pota: '#hamradio #hamtok #amateurradio #FT8 #parksOnTheAir',
    gear: '#hamradio #hamtok #amateurradio #QRP #parksOnTheAir',
    fl:   '#hamradio #hamtok #Florida #amateurradio #parksOnTheAir',
  };

  let selFmt  = 'tiktok';
  let selHtag = 'edu';
  let liveData: any = null;

  // ── Condition helpers ──
  function condFrom(sfi: number | null, kp: number | null) {
    if (kp !== null && kp > 5)     return { label: 'Disturbed',  color: '#ef4444', bands: 'Geomagnetic storm in progress — HF unreliable, polar routes degraded' };
    if (kp !== null && kp > 3)     return { label: 'Unsettled',  color: '#f59e0b', bands: '40m/80m degraded · high bands fair at best · auroral noise possible' };
    if (sfi !== null && sfi > 150) return { label: 'Excellent',  color: '#10b981', bands: '10m–17m wide open · 40m/80m reliable · long-path DX favorable' };
    if (sfi !== null && sfi > 120) return { label: 'Good',       color: '#10b981', bands: '15m–20m good · 40m reliable · upper bands possible' };
    if (sfi !== null && sfi > 90)  return { label: 'Fair',       color: '#f59e0b', bands: '20m–40m fair · skip varies · 80m reliable at night' };
    return                                { label: 'Poor',        color: '#ef4444', bands: '40m/80m best bet · higher bands unreliable · low solar flux' };
  }

  function sfiColor(v: number) { return v > 150 ? '#10b981' : v > 100 ? '#f59e0b' : '#ef4444'; }
  function kpColor(v: number)  { return v <= 3  ? '#10b981' : v <= 5  ? '#f59e0b' : '#ef4444'; }

  // ── Text generators ──
  function overlayText(sfi: number | null, kp: number | null, cond: ReturnType<typeof condFrom>): string {
    const lines: string[] = [];
    if (sfi !== null) lines.push(`SOLAR FLUX ${Math.round(sfi)}`);
    if (kp  !== null) lines.push(`K-INDEX ${kp} — ${kp >= 5 ? 'STORM' : kp >= 3 ? 'UNSETTLED' : 'QUIET'}`);
    const band = cond.bands.match(/(\d+m)/i);
    if (band) lines.push(`${band[1].toUpperCase()} OPEN`);
    return lines.join('\n');
  }

  function captionText(cond: ReturnType<typeof condFrom>, sfi: number | null, kp: number | null): string {
    let t = `${cond.label} conditions for ham radio today.`;
    if (sfi !== null) t += ` Solar flux at ${Math.round(sfi)}.`;
    if (kp  !== null) t += ` Kp ${kp} — ${kp <= 2 ? 'quiet' : kp <= 4 ? 'unsettled' : 'stormy'}.`;
    const firstBand = cond.bands.split('·')[0].trim();
    t += ` ${firstBand}.`;
    if (kp === null || kp <= 3) t += ' Good window for a POTA run.';
    t += ' solar.tavaoneeducation.org';
    return t;
  }

  function titleText(cond: ReturnType<typeof condFrom>, sfi: number | null): string {
    const d = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    return `Ham Radio Solar Conditions — ${cond.label} (SFI ${sfi !== null ? Math.round(sfi) : '—'}) · ${d} | TavaOne Solar`;
  }

  // ── DOM helpers ──
  function setText(id: string, t: string) {
    const el = document.getElementById(id);
    if (el) el.textContent = t;
  }

  function refreshCopyBlocks(data: any) {
    const sfi  = data?.sfi     ?? null;
    const kp   = data?.k_index ?? null;
    const cond = condFrom(sfi, kp);
    setText('overlay-text', overlayText(sfi, kp, cond));
    setText('caption-text', captionText(cond, sfi, kp));
    setText('htag-text',    HTAG[selHtag]);
    setText('title-text',   titleText(cond, sfi));
  }

  // ── Load live data ──
  async function loadCard() {
    try {
      const res = await fetch('/api/solar');
      if (!res.ok) throw new Error('api');
      const d = await res.json();
      liveData = d;

      const sfi  = d.sfi;
      const kp   = d.k_index;
      const ai   = d.a_index;
      const xray = d.xray_class;
      const cond = condFrom(sfi, kp);

      // Timestamp
      const updEl = document.getElementById('card-updated')!;
      updEl.classList.remove('skeleton');
      updEl.textContent = d.updated
        ? new Date(d.updated).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', timeZoneName: 'short' })
        : 'no data';

      // Preview tiles
      for (const id of ['c-sfi','c-kp','c-ai','c-xray']) document.getElementById(id)!.classList.remove('skeleton');

      const eS = document.getElementById('c-sfi')!,  eK = document.getElementById('c-kp')!;
      const eA = document.getElementById('c-ai')!,   eX = document.getElementById('c-xray')!;
      eS.textContent = sfi  !== null ? String(Math.round(sfi)) : '—';
      eK.textContent = kp   !== null ? String(kp)              : '—';
      eA.textContent = ai   !== null ? String(Math.round(ai))  : '—';
      eX.textContent = xray ?? '—';
      if (sfi !== null) eS.style.color = sfiColor(sfi);
      if (kp  !== null) { eK.style.color = kpColor(kp); eA.style.color = kpColor(kp); }

      // Condition banner
      const condLbl = document.getElementById('cond-label')!;
      condLbl.classList.remove('skeleton');
      condLbl.textContent = cond.label;
      condLbl.style.color = cond.color;
      document.getElementById('cond-bands')!.textContent = cond.bands;

      // Alerts
      const alerts = d.alerts ?? [];
      if (alerts.length > 0) {
        const alertEl = document.getElementById('card-alerts')!;
        alertEl.classList.add('visible');
        alertEl.textContent = `⚠ ${alerts[alerts.length - 1].headline}`;
      }

      // Export card values
      const dateStr = new Date().toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
      setText('ec-date', dateStr);
      for (const [id, val, colorFn] of [
        ['ec-sfi',  sfi  !== null ? String(Math.round(sfi)) : '—', sfi  !== null ? () => sfiColor(sfi)  : null],
        ['ec-kp',   kp   !== null ? String(kp)              : '—', kp   !== null ? () => kpColor(kp)    : null],
        ['ec-ai',   ai   !== null ? String(Math.round(ai))  : '—', kp   !== null ? () => kpColor(kp)    : null],
        ['ec-xray', xray ?? '—',                                   null],
      ] as [string, string, (() => string) | null][]) {
        const el = document.getElementById(id)!;
        el.textContent = val;
        if (colorFn) el.style.color = colorFn();
      }
      const ecCL = document.getElementById('ec-cond-label')!;
      ecCL.textContent = cond.label;
      ecCL.style.color = cond.color;
      setText('ec-cond-bands', cond.bands);

      // Enable download
      (document.getElementById('dl-btn') as HTMLButtonElement).disabled = false;

      // Populate post copy
      refreshCopyBlocks(d);

    } catch {
      document.getElementById('card-updated')!.textContent = 'data unavailable';
    }
  }

  // ── Copy buttons ──
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const el = document.getElementById(btn.dataset.target!);
      if (!el) return;
      navigator.clipboard.writeText(el.textContent ?? '').then(() => {
        const orig = btn.textContent!;
        btn.textContent = '✓ DONE';
        btn.classList.add('copied');
        setTimeout(() => { btn.textContent = orig; btn.classList.remove('copied'); }, 2000);
      });
    });
  });

  // ── Format selector ──
  document.querySelectorAll<HTMLButtonElement>('#fmt-group .seg-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#fmt-group .seg-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      selFmt = btn.dataset.fmt!;
    });
  });

  // ── Hashtag set selector ──
  document.querySelectorAll<HTMLButtonElement>('.htag-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.htag-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      selHtag = btn.dataset.set!;
      setText('htag-text', HTAG[selHtag]);
      if (liveData) {
        const sfi = liveData.sfi, kp = liveData.k_index;
        setText('caption-text', captionText(condFrom(sfi, kp), sfi, kp));
      }
    });
  });

  // ── Download PNG ──
  document.getElementById('dl-btn')!.addEventListener('click', async () => {
    const btn = document.getElementById('dl-btn') as HTMLButtonElement;
    const card = document.getElementById('export-card')!;

    const isTikTok = selFmt === 'tiktok';
    const cssW = 360, cssH = isTikTok ? 640 : 360;

    card.style.width         = `${cssW}px`;
    card.style.height        = `${cssH}px`;
    card.style.display       = 'flex';
    card.style.flexDirection = 'column';

    btn.disabled    = true;
    btn.textContent = 'Generating…';

    try {
      const canvas = await html2canvas(card, {
        scale: 3,
        useCORS: true,
        allowTaint: false,
        backgroundColor: '#070b14',
        width: cssW,
        height: cssH,
        logging: false,
      });

      const dateStr = new Date().toISOString().slice(0, 10);
      const link    = document.createElement('a');
      link.download = `solar-${isTikTok ? '9x16' : '1x1'}-${dateStr}.png`;
      link.href     = canvas.toDataURL('image/png');
      link.click();
    } catch (e) {
      console.error('export failed', e);
      alert('PNG export failed — try a screenshot instead.');
    } finally {
      card.style.display = 'none';
      btn.disabled       = false;
      btn.innerHTML      = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1v8M4 7l3 3 3-3M1 10v2a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg> Download PNG`;
    }
  });

  loadCard();
</script>

</div>
</div>

</Shell>
